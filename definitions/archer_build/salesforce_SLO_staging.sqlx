-- Date parsers
CREATE TEMP FUNCTION to_date_safe(x ANY TYPE) AS (
  COALESCE(
    SAFE.PARSE_DATE('%Y-%m-%d', TRIM(CAST(x AS STRING))),
    SAFE.PARSE_DATE('%B %e, %Y', TRIM(CAST(x AS STRING))),  -- September 30, 2024
    SAFE.PARSE_DATE('%b %e, %Y',  TRIM(CAST(x AS STRING))), -- Sep 30, 2024
    SAFE.DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(x AS STRING)))),
    SAFE.DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(x AS STRING)))),
    SAFE.DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S',      TRIM(CAST(x AS STRING))))
  )
);

CREATE TEMP FUNCTION to_iso_date_string(x ANY TYPE) AS (
  COALESCE(
    FORMAT_DATE('%Y-%m-%d', to_date_safe(x)),
    CAST(x AS STRING)
  )
);

CREATE OR REPLACE TABLE `focused-sentry-464713-u0.crm_universal_tables.slo_crm_universal_table` AS
WITH slo_dedup AS (
  SELECT
    lead_Id,
    lead_CreatedDate,
    opportunity_Consult_Date_Time__c,
    opportunity_Consult_Completed__c,
    opportunity_AccountId,
    lead_Web_Lead__c,
    lead_LeadSource,
    lead_Form_Submit_URL__c,
    lead_Google_Campaign__c,
    lead_Google_Content__c,
    lead_Google_ICT_Reference_Number__c,
    lead_Google_Medium__c,
    lead_GA_Source_Medium__c,
    lead_Google_Count_of_Pageviews__c,
    lead_Google_Count_of_Sessions__c,
    lead_Google_Source__c,
    lead_Google_Term__c,
    lead_Google_ClientID__c,
    lead_Google_UserID__c,
    lead_GCLID__c,
    lead_NPS_Score__c,
    lead_IsConverted,
    lead_Potential_Lead__c,
    -- Added for QPC Filter 2
    lead_Referred_Out_Date__c,
    ROW_NUMBER() OVER (PARTITION BY lead_Id ORDER BY lead_CreatedDate DESC) AS rn
  FROM `focused-sentry-464713-u0.salesforce_slo.slo_alldata_delta`
),

slo AS (
  SELECT
    'SterlingLawOffice-1010'  AS Firm_Unique_ID,
    'Sterling Law Office'     AS Firm_Name,

    -- Keep your existing “total lead id” gating (excludes “participant”)
    CASE
      WHEN lead_NPS_Score__c IS NULL
       AND lead_IsConverted = FALSE
       AND lead_Potential_Lead__c = FALSE
       AND NOT REGEXP_CONTAINS(COALESCE(opportunity_AccountId, ''), r'(?i)(?:^|[^A-Za-z0-9_])participant(?:$|[^A-Za-z0-9_])')
      THEN lead_Id ELSE NULL
    END AS Lead_Unique_ID,

    to_iso_date_string(lead_CreatedDate)                 AS Lead_Create_Date,
    to_iso_date_string(opportunity_Consult_Date_Time__c) AS Consultation_Date,
    to_iso_date_string(opportunity_Consult_Completed__c) AS Consult_Completed_Date,
    CAST(NULL AS STRING) AS Retainer_Sent_Date,
    CAST(NULL AS STRING) AS Retainer_Signed_Date,
    CAST(NULL AS STRING) AS Retainer_Funded_Date,

    CASE WHEN lead_Web_Lead__c = TRUE THEN 'true' ELSE NULL END AS Web_Lead_Indicator,

    CAST(lead_LeadSource AS STRING)                       AS Lead_Source,
    CAST(NULL AS STRING)                                  AS Marketing_Channel,
    CAST(lead_Form_Submit_URL__c AS STRING)               AS Form_Submit_URL,
    CAST(lead_Google_Campaign__c AS STRING)               AS UTM_Campaign,
    CAST(lead_Google_Content__c  AS STRING)               AS UTM_Content,
    CAST(COALESCE(lead_Google_Medium__c, lead_GA_Source_Medium__c) AS STRING) AS UTM_Medium,
    CAST(lead_Google_Count_of_Pageviews__c  AS STRING)    AS UTM_Pageview_Count,
    CAST(lead_Google_Count_of_Sessions__c   AS STRING)    AS UTM_Session_Count,
    CAST(lead_Google_Source__c              AS STRING)    AS UTM_Source,
    CAST(lead_Google_Term__c                AS STRING)    AS UTM_Term,
    CAST(lead_GCLID__c                      AS STRING)    AS gclid,

    -- ===================== QPC =====================
    -- Filter 1 condition
    (
      lead_NPS_Score__c IS NULL
      AND lead_IsConverted = FALSE
      AND lead_Potential_Lead__c = FALSE
      AND REGEXP_CONTAINS(COALESCE(opportunity_AccountId, ''), r'(?i)(?:^|[^A-Za-z0-9_])participant(?:$|[^A-Za-z0-9_])')
    ) AS _f1,

    -- Filter 2 “Referred Out” (subset of Filter 1)
    (
      -- treat Referred_Out as TRUE if it's a boolean TRUE OR a non-null parsable date
      (SAFE_CAST(lead_Referred_Out_Date__c AS BOOL) IS TRUE OR to_date_safe(lead_Referred_Out_Date__c) IS NOT NULL)
      AND lead_NPS_Score__c IS NULL
      AND lead_IsConverted = FALSE
      AND lead_Potential_Lead__c = FALSE
      AND REGEXP_CONTAINS(COALESCE(opportunity_AccountId, ''), r'(?i)(?:^|[^A-Za-z0-9_])participant(?:$|[^A-Za-z0-9_])')
    ) AS _f2,

  
    CASE WHEN
      (lead_NPS_Score__c IS NULL
       AND lead_IsConverted = FALSE
       AND lead_Potential_Lead__c = FALSE
       AND REGEXP_CONTAINS(COALESCE(opportunity_AccountId, ''), r'(?i)(?:^|[^A-Za-z0-9_])participant(?:$|[^A-Za-z0-9_])'))
      AND NOT (SAFE_CAST(lead_Referred_Out_Date__c AS BOOL) IS TRUE OR to_date_safe(lead_Referred_Out_Date__c) IS NOT NULL)
    THEN 'true' ELSE NULL END AS QPC,
    -- ==============================================

    CAST(lead_Google_ICT_Reference_Number__c AS STRING)   AS UTM_ICT_Reference_Number,
    CAST(lead_Google_ClientID__c AS STRING)               AS ga_client_id,
    CAST(lead_Google_UserID__c  AS STRING)                AS ga_user_id
  FROM slo_dedup
  WHERE rn = 1
)

SELECT
  Firm_Unique_ID,
  Firm_Name,
  Lead_Unique_ID,
  Lead_Create_Date,
  Consultation_Date,
  Consult_Completed_Date,
  Retainer_Sent_Date,
  Retainer_Signed_Date,
  Retainer_Funded_Date,
  Web_Lead_Indicator,
  Lead_Source,
  Marketing_Channel,
  Form_Submit_URL,
  UTM_Campaign,
  UTM_Content,
  UTM_Medium,
  UTM_Pageview_Count,
  UTM_Session_Count,
  UTM_Source,
  UTM_Term,
  gclid,
  QPC,  
  UTM_ICT_Reference_Number,
  ga_client_id,
  ga_user_id
FROM slo;
