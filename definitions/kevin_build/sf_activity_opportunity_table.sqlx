  S.opp_owner_id, S.opp_owner_name, S.opp_owner_email, S.opp_pipeline_owner, S.opp_pipeline_owner_name, S.opp_created_date,
  S.opportunity_matched
);


-- ============================================================
-- INSERT 2: DATAMART BYPASS FOR ORPHANED EMAILS
-- Captures emails missing from activity_universal but linked to Opps
-- ============================================================

INSERT INTO `sterling-lawyers-database.sterling_sf_datamart.activity_opportunity_enriched` (
  sf_record_id, source_object, bq_source_table, what_id, subject, 
  activity_type, task_subtype, start_datetime, completed_datetime, 
  created_by_id, created_date, last_modified_by_id, last_modified_date, 
  system_modstamp, 
  
  -- EmailMessage fields
  email_parent_id, email_activity_id, email_text_body, email_html_body, 
  email_headers, email_name, email_from_name, email_from_address, 
  email_validated_from_address, email_to_address, email_cc_address, 
  email_bcc_address, email_incoming, email_has_attachment, email_message_date, 
  email_reply_to_email_message_id, email_is_private_draft, email_is_externally_visible, 
  email_message_identifier, email_thread_identifier, email_client_thread_identifier, 
  email_from_id, email_is_client_managed, email_attachment_ids, email_related_to_id, 
  email_is_tracked, email_is_opened, email_first_opened_date, email_last_opened_date, 
  email_is_bounced, email_template_id, email_routing_address_id, email_automation_type, 
  email_source, matter_is_7_years, matter_complete_date_from_opp,
  
  -- Opportunity fields
  bq_loaded_at, opportunity_id, opportunity_name, stage_name, is_closed, is_won,
  opp_consult_type, opp_consult_status, opp_consult_datetime,
  opp_consult_attorney, opp_consult_location, opp_type_of_matter, opp_case_code, 
  opp_lead_source, opp_marketing_source, opp_marketing_campaign,
  client_first_name, client_last_name, client_full_name, client_email, client_phase,
  opp_owner_id, opp_owner_name, opp_owner_email, opp_pipeline_owner, 
  opp_pipeline_owner_name, opp_created_date, opportunity_matched
)
SELECT 
  e.ActivityId                          AS sf_record_id,
  'EmailMessage'                        AS source_object,
  'sf_email'                            AS bq_source_table,
  e.RelatedToId                         AS what_id,
  e.Subject                             AS subject,
  'Email'                               AS activity_type,
  'Email'                               AS task_subtype,
  e.MessageDate                         AS start_datetime,
  e.MessageDate                         AS completed_datetime,
  e.CreatedById                         AS created_by_id,
  e.CreatedDate                         AS created_date,
  e.LastModifiedById                    AS last_modified_by_id,
  e.LastModifiedDate                    AS last_modified_date,
  e.SystemModstamp                      AS system_modstamp,

  -- Email values
  e.ParentId, e.ActivityId, e.TextBody, e.HtmlBody, 
  e.Headers, e.Name, e.FromName, e.FromAddress, 
  e.ValidatedFromAddress, e.ToAddress, e.CcAddress, 
  e.BccAddress, e.Incoming, e.HasAttachment, e.MessageDate, 
  e.ReplyToEmailMessageId, e.IsPrivateDraft, e.IsExternallyVisible, 
  e.MessageIdentifier, e.ThreadIdentifier, e.ClientThreadIdentifier, 
  e.FromId, e.IsClientManaged, e.AttachmentIds, e.RelatedToId, 
  e.IsTracked, e.IsOpened, e.FirstOpenedDate, e.LastOpenedDate, 
  e.IsBounced, e.EmailTemplateId, e.EmailRoutingAddressId, e.AutomationType, 
  e.Source, e.MatterIS7Years__c, e.Matter_Complete_Date_from_Opp__c,

  -- Opportunity values
  CURRENT_TIMESTAMP()                   AS bq_loaded_at,
  o.Id, o.Name, o.StageName, o.IsClosed, o.IsWon,
  o.Consult_Type__c, o.Consult_Status__c, o.Consult_Date_Time__c,
  o.Consult_Attorney__c, o.Consult_Location__c, o.Type_of_Matter__c, o.Case_Code__c,
  o.LeadSource, o.Marketing_Source__c, o.Marketing_Campaign__c,
  o.Client_First_Name__c, o.Client_Last_Name__c, o.Client_Full_Name__c, o.Client_Email__c, o.Client_Phase__c,
  o.OwnerId, o.Owner_Name__c, o.Owner_Email__c, o.Pipeline_Owner__c, 
  o.Pipeline_Owner_Name__c, o.CreatedDate,
  TRUE                                  AS opportunity_matched

FROM `sterling-lawyers-database.sterling_sf_staging.sf_email` AS e
JOIN `sterling-lawyers-database.sterling_salesforce_raw_data.Opportunity` AS o
  ON e.RelatedToId = o.Id
WHERE e.RelatedToId LIKE '006%'
  AND o.IsDeleted = FALSE
  AND e.ActivityId NOT IN (
    SELECT sf_record_id 
    FROM `sterling-lawyers-database.sterling_sf_datamart.activity_universal` 
    WHERE sf_record_id IS NOT NULL
  );