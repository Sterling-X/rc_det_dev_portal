-- ============================================================
-- CREATE: sterling_sf_datamart.activity_opportunity_enriched
-- Enriches activity_universal with matched Opportunity data
-- Partition : DATE(completed_datetime)
-- Cluster   : source_object, owner_id, consult_type, stage_name
-- ============================================================

CREATE TABLE IF NOT EXISTS `sterling-lawyers-database.sterling_sf_datamart.activity_opportunity_enriched` (
  sf_record_id              STRING,
  source_object             STRING,
  bq_source_table           STRING,
  owner_id                  STRING,
  owner_role                STRING,
  attorney_name             STRING,
  assigned_to               STRING,
  who_id                    STRING,
  what_id                   STRING,
  account_id                STRING,
  subject                   STRING,
  activity_type             STRING,
  disposition               STRING,
  status                    STRING,
  priority                  STRING,
  consult_type              STRING,
  consult_attorney          STRING,
  consult_location          STRING,
  consult_date              DATE,
  start_datetime            TIMESTAMP,
  end_datetime              TIMESTAMP,
  completed_datetime        TIMESTAMP,
  duration_minutes          INTEGER,
  opportunity_id            STRING,
  opportunity_name          STRING,
  stage_name                STRING,
  is_closed                 BOOLEAN,
  is_won                    BOOLEAN,
  opp_consult_type          STRING,
  opp_consult_status        STRING,
  opp_consult_datetime      TIMESTAMP,
  opp_consult_attorney      STRING,
  opp_consult_location      STRING,
  opp_type_of_matter        STRING,
  opp_case_code             STRING,
  opp_lead_source           STRING,
  opp_marketing_source      STRING,
  opp_marketing_campaign    STRING,
  client_first_name         STRING,
  client_last_name          STRING,
  client_full_name          STRING,
  client_email              STRING,
  client_phase              STRING,
  client_mobile             STRING,
  opp_owner_id              STRING,
  opp_owner_name            STRING,
  opp_owner_email           STRING,
  opp_pipeline_owner        STRING,
  opp_pipeline_owner_name   STRING,
  opp_created_date          TIMESTAMP,
  opportunity_matched       BOOLEAN,
  nps_score                 FLOAT64,
  review_score              FLOAT64,
  review_comments           STRING,
  reviewed_site             STRING,
  notes                     STRING,
  next_steps                STRING,
  is_deleted                BOOLEAN,
  is_archived               BOOLEAN,
  created_date              TIMESTAMP,
  last_modified_date        TIMESTAMP,
  bq_loaded_at              TIMESTAMP
)
PARTITION BY DATE(completed_datetime)
CLUSTER BY source_object, owner_id, consult_type, stage_name;


-- ============================================================
-- MERGE: activity_opportunity_enriched
-- Source  : activity_universal LEFT JOIN Opportunity
-- PK      : sf_record_id
-- Guard   : WHEN MATCHED only fires if source is strictly newer
-- ============================================================

MERGE `sterling-lawyers-database.sterling_sf_datamart.activity_opportunity_enriched` AS T
USING (

  SELECT
    a.sf_record_id,
    a.source_object,
    a.bq_source_table,
    a.owner_id,
    a.owner_role,
    a.attorney_name,
    a.assigned_to,
    a.who_id,
    a.what_id,
    a.account_id,
    a.subject,
    a.activity_type,
    a.disposition,
    a.status,
    a.priority,
    a.consult_type,
    a.consult_attorney,
    a.consult_location,
    a.consult_date,
    a.start_datetime,
    a.end_datetime,
    a.completed_datetime,
    a.duration_minutes,

    o.Id                              AS opportunity_id,
    o.Name                            AS opportunity_name,
    o.StageName                       AS stage_name,
    o.IsClosed                        AS is_closed,
    o.IsWon                           AS is_won,
    o.Consult_Type__c                 AS opp_consult_type,
    o.Consult_Status__c               AS opp_consult_status,
    o.Consult_Date_Time__c            AS opp_consult_datetime,
    o.Consult_Attorney__c             AS opp_consult_attorney,
    o.Consult_Location__c             AS opp_consult_location,
    o.Type_of_Matter__c               AS opp_type_of_matter,
    o.Case_Code__c                    AS opp_case_code,
    o.LeadSource                      AS opp_lead_source,
    o.Marketing_Source__c             AS opp_marketing_source,
    o.Marketing_Campaign__c           AS opp_marketing_campaign,
    o.Client_First_Name__c            AS client_first_name,
    o.Client_Last_Name__c             AS client_last_name,
    o.Client_Full_Name__c             AS client_full_name,
    o.Client_Email__c                 AS client_email,
    o.Client_Phase__c                 AS client_phase,
    a.client_mobile                   AS client_mobile,
    o.OwnerId                         AS opp_owner_id,
    o.Owner_Name__c                   AS opp_owner_name,
    o.Owner_Email__c                  AS opp_owner_email,
    o.Pipeline_Owner__c               AS opp_pipeline_owner,
    o.Pipeline_Owner_Name__c          AS opp_pipeline_owner_name,
    o.CreatedDate                     AS opp_created_date,
    CASE WHEN o.Id IS NOT NULL
      THEN TRUE ELSE FALSE
    END                               AS opportunity_matched,

    a.nps_score,
    a.review_score,
    a.review_comments,
    a.reviewed_site,
    a.notes,
    a.next_steps,
    a.is_deleted,
    a.is_archived,
    a.created_date,
    a.last_modified_date,
    CURRENT_TIMESTAMP()               AS bq_loaded_at

  FROM `sterling-lawyers-database.sterling_sf_datamart.activity_universal` AS a
  LEFT JOIN `sterling-lawyers-database.sterling_salesforce_raw_data.Opportunity` AS o
    ON  o.Id       = a.what_id
    AND a.what_id  LIKE '006%'
    AND o.IsDeleted = FALSE

) AS S
ON T.sf_record_id = S.sf_record_id

WHEN MATCHED AND S.last_modified_date > T.last_modified_date THEN UPDATE SET
  T.source_object             = S.source_object,
  T.bq_source_table           = S.bq_source_table,
  T.owner_id                  = S.owner_id,
  T.owner_role                = S.owner_role,
  T.attorney_name             = S.attorney_name,
  T.assigned_to               = S.assigned_to,
  T.who_id                    = S.who_id,
  T.what_id                   = S.what_id,
  T.account_id                = S.account_id,
  T.subject                   = S.subject,
  T.activity_type             = S.activity_type,
  T.disposition               = S.disposition,
  T.status                    = S.status,
  T.priority                  = S.priority,
  T.consult_type              = S.consult_type,
  T.consult_attorney          = S.consult_attorney,
  T.consult_location          = S.consult_location,
  T.consult_date              = S.consult_date,
  T.start_datetime            = S.start_datetime,
  T.end_datetime              = S.end_datetime,
  T.completed_datetime        = S.completed_datetime,
  T.duration_minutes          = S.duration_minutes,
  T.opportunity_id            = S.opportunity_id,
  T.opportunity_name          = S.opportunity_name,
  T.stage_name                = S.stage_name,
  T.is_closed                 = S.is_closed,
  T.is_won                    = S.is_won,
  T.opp_consult_type          = S.opp_consult_type,
  T.opp_consult_status        = S.opp_consult_status,
  T.opp_consult_datetime      = S.opp_consult_datetime,
  T.opp_consult_attorney      = S.opp_consult_attorney,
  T.opp_consult_location      = S.opp_consult_location,
  T.opp_type_of_matter        = S.opp_type_of_matter,
  T.opp_case_code             = S.opp_case_code,
  T.opp_lead_source           = S.opp_lead_source,
  T.opp_marketing_source      = S.opp_marketing_source,
  T.opp_marketing_campaign    = S.opp_marketing_campaign,
  T.client_first_name         = S.client_first_name,
  T.client_last_name          = S.client_last_name,
  T.client_full_name          = S.client_full_name,
  T.client_email              = S.client_email,
  T.client_phase              = S.client_phase,
  T.client_mobile             = S.client_mobile,
  T.opp_owner_id              = S.opp_owner_id,
  T.opp_owner_name            = S.opp_owner_name,
  T.opp_owner_email           = S.opp_owner_email,
  T.opp_pipeline_owner        = S.opp_pipeline_owner,
  T.opp_pipeline_owner_name   = S.opp_pipeline_owner_name,
  T.opp_created_date          = S.opp_created_date,
  T.opportunity_matched       = S.opportunity_matched,
  T.nps_score                 = S.nps_score,
  T.review_score              = S.review_score,
  T.review_comments           = S.review_comments,
  T.reviewed_site             = S.reviewed_site,
  T.notes                     = S.notes,
  T.next_steps                = S.next_steps,
  T.is_deleted                = S.is_deleted,
  T.is_archived               = S.is_archived,
  T.last_modified_date        = S.last_modified_date,
  T.bq_loaded_at              = S.bq_loaded_at

WHEN NOT MATCHED THEN INSERT (
  sf_record_id, source_object, bq_source_table,
  owner_id, owner_role, attorney_name, assigned_to,
  who_id, what_id, account_id,
  subject, activity_type, disposition, status, priority,
  consult_type, consult_attorney, consult_location, consult_date,
  start_datetime, end_datetime, completed_datetime, duration_minutes,
  opportunity_id, opportunity_name, stage_name, is_closed, is_won,
  opp_consult_type, opp_consult_status, opp_consult_datetime,
  opp_consult_attorney, opp_consult_location,
  opp_type_of_matter, opp_case_code, opp_lead_source,
  opp_marketing_source, opp_marketing_campaign,
  client_first_name, client_last_name, client_full_name,
  client_email, client_phase, client_mobile,
  opp_owner_id, opp_owner_name, opp_owner_email,
  opp_pipeline_owner, opp_pipeline_owner_name, opp_created_date,
  opportunity_matched,
  nps_score, review_score, review_comments, reviewed_site,
  notes, next_steps, is_deleted, is_archived,
  created_date, last_modified_date, bq_loaded_at
)
VALUES (
  S.sf_record_id, S.source_object, S.bq_source_table,
  S.owner_id, S.owner_role, S.attorney_name, S.assigned_to,
  S.who_id, S.what_id, S.account_id,
  S.subject, S.activity_type, S.disposition, S.status, S.priority,
  S.consult_type, S.consult_attorney, S.consult_location, S.consult_date,
  S.start_datetime, S.end_datetime, S.completed_datetime, S.duration_minutes,
  S.opportunity_id, S.opportunity_name, S.stage_name, S.is_closed, S.is_won,
  S.opp_consult_type, S.opp_consult_status, S.opp_consult_datetime,
  S.opp_consult_attorney, S.opp_consult_location,
  S.opp_type_of_matter, S.opp_case_code, S.opp_lead_source,
  S.opp_marketing_source, S.opp_marketing_campaign,
  S.client_first_name, S.client_last_name, S.client_full_name,
  S.client_email, S.client_phase, S.client_mobile,
  S.opp_owner_id, S.opp_owner_name, S.opp_owner_email,
  S.opp_pipeline_owner, S.opp_pipeline_owner_name, S.opp_created_date,
  S.opportunity_matched,
  S.nps_score, S.review_score, S.review_comments, S.reviewed_site,
  S.notes, S.next_steps, S.is_deleted, S.is_archived,
  S.created_date, S.last_modified_date, S.bq_loaded_at
);