-- ============================================================
-- CREATE: sterling_sf_datamart.activity_opportunity_enriched
-- Full superset of activity_universal + Opportunity + EmailMessage join fields
-- Partition : DATE(completed_datetime)
-- Cluster   : source_object, owner_id, consult_type, stage_name
-- ============================================================

CREATE TABLE IF NOT EXISTS `sterling-lawyers-database.sterling_sf_datamart.activity_opportunity_enriched` (
  sf_record_id                  STRING,
  source_object                 STRING,
  bq_source_table               STRING,
  account_id                    STRING,
  owner_id                      STRING,
  record_type_id                STRING,
  who_id                        STRING,
  what_id                       STRING,
  subject                       STRING,
  description                   STRING,
  activity_type                 STRING,
  event_subtype                 STRING,   
  task_subtype                  STRING,   
  disposition                   STRING,
  status                        STRING,
  priority                      STRING,
  start_datetime                TIMESTAMP,
  end_datetime                  TIMESTAMP,
  completed_datetime            TIMESTAMP,
  duration_minutes              INTEGER,
  consult_attorney              STRING,
  consult_type                  STRING,
  consult_location              STRING,
  consult_date                  DATE,
  original_consult_attorney     STRING,
  original_consult_datetime     TIMESTAMP,
  original_consult_location     STRING,
  reschedule_reason             STRING,
  reschedule_notes              STRING,
  location                      STRING,
  google_meet_link              STRING,
  zoom_link                     STRING,
  zoom_passcode                 STRING,
  meeting_room                  STRING,
  owner_role                    STRING,
  attorney_name                 STRING,
  assigned_to                   STRING,
  client_mobile                 STRING,
  company_name                  STRING,
  nps_score                     FLOAT64,
  review_score                  FLOAT64,
  review_comments               STRING,
  reviewed_site                 STRING,
  state                         STRING,
  notes                         STRING,
  next_steps                    STRING,
  text_message                  STRING,
  is_recurring                  BOOLEAN,
  is_all_day                    BOOLEAN,
  is_group_event                BOOLEAN,
  is_deleted                    BOOLEAN,
  is_archived                   BOOLEAN,
  created_by_id                 STRING,
  created_date                  TIMESTAMP,
  last_modified_by_id           STRING,
  last_modified_date            TIMESTAMP,
  system_modstamp               TIMESTAMP,
  old_org_record_id             STRING,
  external_sync_id              STRING,
  email_parent_id                 STRING,
  email_activity_id               STRING,
  email_text_body                 STRING,
  email_html_body                 STRING,
  email_headers                   STRING,
  email_name                      STRING,
  email_from_name                 STRING,
  email_from_address              STRING,
  email_validated_from_address    STRING,
  email_to_address                STRING,
  email_cc_address                STRING,
  email_bcc_address               STRING,
  email_incoming                  BOOLEAN,
  email_has_attachment            BOOLEAN,
  email_message_date              TIMESTAMP,
  email_reply_to_email_message_id STRING,
  email_is_private_draft          BOOLEAN,
  email_is_externally_visible     BOOLEAN,
  email_message_identifier        STRING,
  email_thread_identifier         STRING,
  email_client_thread_identifier  STRING,
  email_from_id                   STRING,
  email_is_client_managed         BOOLEAN,
  email_attachment_ids            STRING,
  email_related_to_id             STRING,
  email_is_tracked                BOOLEAN,
  email_is_opened                 BOOLEAN,
  email_first_opened_date         TIMESTAMP,
  email_last_opened_date          TIMESTAMP,
  email_is_bounced                BOOLEAN,
  email_template_id               STRING,
  email_routing_address_id        STRING,
  email_automation_type           STRING,
  email_source                    STRING,
  matter_is_7_years               BOOLEAN,
  matter_complete_date_from_opp   DATE,
  bq_loaded_at                  TIMESTAMP,
  opportunity_id                STRING,
  opportunity_name              STRING,
  stage_name                    STRING,
  is_closed                     BOOLEAN,
  is_won                        BOOLEAN,
  opp_consult_type              STRING,
  opp_consult_status            STRING,
  opp_consult_datetime          TIMESTAMP,
  opp_consult_attorney          STRING,
  opp_consult_location          STRING,
  opp_type_of_matter            STRING,
  opp_case_code                 STRING,
  opp_lead_source               STRING,
  opp_marketing_source          STRING,
  opp_marketing_campaign        STRING,
  client_first_name             STRING,
  client_last_name              STRING,
  client_full_name              STRING,
  client_email                  STRING,
  client_phase                  STRING,
  opp_owner_id                  STRING,
  opp_owner_name                STRING,
  opp_owner_email               STRING,
  opp_pipeline_owner            STRING,
  opp_pipeline_owner_name       STRING,
  opp_created_date              TIMESTAMP,
  opportunity_matched           BOOLEAN
)
PARTITION BY DATE(completed_datetime)
CLUSTER BY source_object, owner_id, consult_type, stage_name;


-- ============================================================
-- PATCH SCHEMA: Add new columns if table already existed
-- ============================================================
ALTER TABLE `sterling-lawyers-database.sterling_sf_datamart.activity_opportunity_enriched`
ADD COLUMN IF NOT EXISTS event_subtype STRING,
ADD COLUMN IF NOT EXISTS task_subtype  STRING,
ADD COLUMN IF NOT EXISTS email_parent_id STRING,
ADD COLUMN IF NOT EXISTS email_activity_id STRING,
ADD COLUMN IF NOT EXISTS email_text_body STRING,
ADD COLUMN IF NOT EXISTS email_html_body STRING,
ADD COLUMN IF NOT EXISTS email_headers STRING,
ADD COLUMN IF NOT EXISTS email_name STRING,
ADD COLUMN IF NOT EXISTS email_from_name STRING,
ADD COLUMN IF NOT EXISTS email_from_address STRING,
ADD COLUMN IF NOT EXISTS email_validated_from_address STRING,
ADD COLUMN IF NOT EXISTS email_to_address STRING,
ADD COLUMN IF NOT EXISTS email_cc_address STRING,
ADD COLUMN IF NOT EXISTS email_bcc_address STRING,
ADD COLUMN IF NOT EXISTS email_incoming BOOLEAN,
ADD COLUMN IF NOT EXISTS email_has_attachment BOOLEAN,
ADD COLUMN IF NOT EXISTS email_message_date TIMESTAMP,
ADD COLUMN IF NOT EXISTS email_reply_to_email_message_id STRING,
ADD COLUMN IF NOT EXISTS email_is_private_draft BOOLEAN,
ADD COLUMN IF NOT EXISTS email_is_externally_visible BOOLEAN,
ADD COLUMN IF NOT EXISTS email_message_identifier STRING,
ADD COLUMN IF NOT EXISTS email_thread_identifier STRING,
ADD COLUMN IF NOT EXISTS email_client_thread_identifier STRING,
ADD COLUMN IF NOT EXISTS email_from_id STRING,
ADD COLUMN IF NOT EXISTS email_is_client_managed BOOLEAN,
ADD COLUMN IF NOT EXISTS email_attachment_ids STRING,
ADD COLUMN IF NOT EXISTS email_related_to_id STRING,
ADD COLUMN IF NOT EXISTS email_is_tracked BOOLEAN,
ADD COLUMN IF NOT EXISTS email_is_opened BOOLEAN,
ADD COLUMN IF NOT EXISTS email_first_opened_date TIMESTAMP,
ADD COLUMN IF NOT EXISTS email_last_opened_date TIMESTAMP,
ADD COLUMN IF NOT EXISTS email_is_bounced BOOLEAN,
ADD COLUMN IF NOT EXISTS email_template_id STRING,
ADD COLUMN IF NOT EXISTS email_routing_address_id STRING,
ADD COLUMN IF NOT EXISTS email_automation_type STRING,
ADD COLUMN IF NOT EXISTS email_source STRING,
ADD COLUMN IF NOT EXISTS matter_is_7_years BOOLEAN,
ADD COLUMN IF NOT EXISTS matter_complete_date_from_opp DATE;

ALTER TABLE `sterling-lawyers-database.sterling_sf_datamart.activity_opportunity_enriched`
DROP COLUMN IF EXISTS activity_subtype;


-- ============================================================
-- MERGE 1: STANDARD UPSERT
-- Updates existing records and inserts matches from activity_universal
-- ============================================================

MERGE `sterling-lawyers-database.sterling_sf_datamart.activity_opportunity_enriched` AS T
USING (

  SELECT
    a.sf_record_id, a.source_object, a.bq_source_table, a.account_id, a.owner_id,
    a.record_type_id, a.who_id, a.what_id, a.subject, a.description,
    a.activity_type, a.event_subtype, a.task_subtype, a.disposition, a.status,
    a.priority, a.start_datetime, a.end_datetime, a.completed_datetime, a.duration_minutes,
    a.consult_attorney, a.consult_type, a.consult_location, a.consult_date,
    a.original_consult_attorney, a.original_consult_datetime, a.original_consult_location,
    a.reschedule_reason, a.reschedule_notes, a.location, a.google_meet_link,
    a.zoom_link, a.zoom_passcode, a.meeting_room, a.owner_role, a.attorney_name,
    a.assigned_to, a.client_mobile, a.company_name, a.nps_score, a.review_score,
    a.review_comments, a.reviewed_site, a.state, a.notes, a.next_steps, a.text_message,
    a.is_recurring, a.is_all_day, a.is_group_event, a.is_deleted, a.is_archived,
    a.created_by_id, a.created_date, a.last_modified_by_id, a.last_modified_date,
    a.system_modstamp, a.old_org_record_id, a.external_sync_id,

    -- Map EmailMessage Fields
    e.ParentId AS email_parent_id, e.ActivityId AS email_activity_id, e.TextBody AS email_text_body, 
    e.HtmlBody AS email_html_body, e.Headers AS email_headers, e.Name AS email_name, 
    e.FromName AS email_from_name, e.FromAddress AS email_from_address, 
    e.ValidatedFromAddress AS email_validated_from_address, e.ToAddress AS email_to_address, 
    e.CcAddress AS email_cc_address, e.BccAddress AS email_bcc_address, e.Incoming AS email_incoming, 
    e.HasAttachment AS email_has_attachment, e.MessageDate AS email_message_date, 
    e.ReplyToEmailMessageId AS email_reply_to_email_message_id, e.IsPrivateDraft AS email_is_private_draft, 
    e.IsExternallyVisible AS email_is_externally_visible, e.MessageIdentifier AS email_message_identifier, 
    e.ThreadIdentifier AS email_thread_identifier, e.ClientThreadIdentifier AS email_client_thread_identifier, 
    e.FromId AS email_from_id, e.IsClientManaged AS email_is_client_managed, 
    e.AttachmentIds AS email_attachment_ids, e.RelatedToId AS email_related_to_id, 
    e.IsTracked AS email_is_tracked, e.IsOpened AS email_is_opened, e.FirstOpenedDate AS email_first_opened_date, 
    e.LastOpenedDate AS email_last_opened_date, e.IsBounced AS email_is_bounced, 
    e.EmailTemplateId AS email_template_id, e.EmailRoutingAddressId AS email_routing_address_id, 
    e.AutomationType AS email_automation_type, e.Source AS email_source, 
    e.MatterIS7Years__c AS matter_is_7_years, e.Matter_Complete_Date_from_Opp__c AS matter_complete_date_from_opp,

    CURRENT_TIMESTAMP() AS bq_loaded_at,
    o.Id AS opportunity_id, o.Name AS opportunity_name, o.StageName AS stage_name, 
    o.IsClosed AS is_closed, o.IsWon AS is_won, o.Consult_Type__c AS opp_consult_type, 
    o.Consult_Status__c AS opp_consult_status, o.Consult_Date_Time__c AS opp_consult_datetime, 
    o.Consult_Attorney__c AS opp_consult_attorney, o.Consult_Location__c AS opp_consult_location, 
    o.Type_of_Matter__c AS opp_type_of_matter, o.Case_Code__c AS opp_case_code, 
    o.LeadSource AS opp_lead_source, o.Marketing_Source__c AS opp_marketing_source, 
    o.Marketing_Campaign__c AS opp_marketing_campaign, o.Client_First_Name__c AS client_first_name, 
    o.Client_Last_Name__c AS client_last_name, o.Client_Full_Name__c AS client_full_name, 
    o.Client_Email__c AS client_email, o.Client_Phase__c AS client_phase, o.OwnerId AS opp_owner_id, 
    o.Owner_Name__c AS opp_owner_name, o.Owner_Email__c AS opp_owner_email, 
    o.Pipeline_Owner__c AS opp_pipeline_owner, o.Pipeline_Owner_Name__c AS opp_pipeline_owner_name, 
    o.CreatedDate AS opp_created_date,
    CASE WHEN o.Id IS NOT NULL THEN TRUE ELSE FALSE END AS opportunity_matched

  FROM `sterling-lawyers-database.sterling_sf_datamart.activity_universal` AS a
  LEFT JOIN `sterling-lawyers-database.sterling_salesforce_raw_data.Opportunity` AS o
    ON o.Id = a.what_id AND a.what_id LIKE '006%' AND o.IsDeleted = FALSE
  LEFT JOIN `sterling-lawyers-database.sterling_sf_staging.sf_email` AS e
    ON e.ActivityId = a.sf_record_id
    
) AS S
ON T.sf_record_id = S.sf_record_id

-- UPDATE EXISTING
WHEN MATCHED AND S.last_modified_date > T.last_modified_date THEN UPDATE SET
  T.source_object = S.source_object, T.bq_source_table = S.bq_source_table, T.account_id = S.account_id,
  T.owner_id = S.owner_id, T.record_type_id = S.record_type_id, T.who_id = S.who_id, T.what_id = S.what_id,
  T.subject = S.subject, T.description = S.description, T.activity_type = S.activity_type,
  T.event_subtype = S.event_subtype, T.task_subtype = S.task_subtype, T.disposition = S.disposition,
  T.status = S.status, T.priority = S.priority, T.start_datetime = S.start_datetime,
  T.end_datetime = S.end_datetime, T.completed_datetime = S.completed_datetime,
  T.duration_minutes = S.duration_minutes, T.consult_attorney = S.consult_attorney,
  T.consult_type = S.consult_type, T.consult_location = S.consult_location, T.consult_date = S.consult_date,
  T.original_consult_attorney = S.original_consult_attorney, T.original_consult_datetime = S.original_consult_datetime,
  T.original_consult_location = S.original_consult_location, T.reschedule_reason = S.reschedule_reason,
  T.reschedule_notes = S.reschedule_notes, T.location = S.location, T.google_meet_link = S.google_meet_link,
  T.zoom_link = S.zoom_link, T.zoom_passcode = S.zoom_passcode, T.meeting_room = S.meeting_room,
  T.owner_role = S.owner_role, T.attorney_name = S.attorney_name, T.assigned_to = S.assigned_to,
  T.client_mobile = S.client_mobile, T.company_name = S.company_name, T.nps_score = S.nps_score,
  T.review_score = S.review_score, T.review_comments = S.review_comments, T.reviewed_site = S.reviewed_site,
  T.state = S.state, T.notes = S.notes, T.next_steps = S.next_steps, T.text_message = S.text_message,
  T.is_recurring = S.is_recurring, T.is_all_day = S.is_all_day, T.is_group_event = S.is_group_event,
  T.is_deleted = S.is_deleted, T.is_archived = S.is_archived, T.created_by_id = S.created_by_id,
  T.last_modified_by_id = S.last_modified_by_id, T.last_modified_date = S.last_modified_date,
  T.system_modstamp = S.system_modstamp, T.old_org_record_id = S.old_org_record_id,
  T.external_sync_id = S.external_sync_id,
  
  -- Update Email fields
  T.email_parent_id = S.email_parent_id, T.email_activity_id = S.email_activity_id, T.email_text_body = S.email_text_body, 
  T.email_html_body = S.email_html_body, T.email_headers = S.email_headers, T.email_name = S.email_name, 
  T.email_from_name = S.email_from_name, T.email_from_address = S.email_from_address, 
  T.email_validated_from_address = S.email_validated_from_address, T.email_to_address = S.email_to_address, 
  T.email_cc_address = S.email_cc_address, T.email_bcc_address = S.email_bcc_address, T.email_incoming = S.email_incoming, 
  T.email_has_attachment = S.email_has_attachment, T.email_message_date = S.email_message_date, 
  T.email_reply_to_email_message_id = S.email_reply_to_email_message_id, T.email_is_private_draft = S.email_is_private_draft, 
  T.email_is_externally_visible = S.email_is_externally_visible, T.email_message_identifier = S.email_message_identifier, 
  T.email_thread_identifier = S.email_thread_identifier, T.email_client_thread_identifier = S.email_client_thread_identifier, 
  T.email_from_id = S.email_from_id, T.email_is_client_managed = S.email_is_client_managed, 
  T.email_attachment_ids = S.email_attachment_ids, T.email_related_to_id = S.email_related_to_id, 
  T.email_is_tracked = S.email_is_tracked, T.email_is_opened = S.email_is_opened, T.email_first_opened_date = S.email_first_opened_date, 
  T.email_last_opened_date = S.email_last_opened_date, T.email_is_bounced = S.email_is_bounced, 
  T.email_template_id = S.email_template_id, T.email_routing_address_id = S.email_routing_address_id, 
  T.email_automation_type = S.email_automation_type, T.email_source = S.email_source, 
  T.matter_is_7_years = S.matter_is_7_years, T.matter_complete_date_from_opp = S.matter_complete_date_from_opp,

  T.bq_loaded_at = S.bq_loaded_at, T.opportunity_id = S.opportunity_id, T.opportunity_name = S.opportunity_name, 
  T.stage_name = S.stage_name, T.is_closed = S.is_closed, T.is_won = S.is_won, T.opp_consult_type = S.opp_consult_type, 
  T.opp_consult_status = S.opp_consult_status, T.opp_consult_datetime = S.opp_consult_datetime, 
  T.opp_consult_attorney = S.opp_consult_attorney, T.opp_consult_location = S.opp_consult_location, 
  T.opp_type_of_matter = S.opp_type_of_matter, T.opp_case_code = S.opp_case_code, T.opp_lead_source = S.opp_lead_source, 
  T.opp_marketing_source = S.opp_marketing_source, T.opp_marketing_campaign = S.opp_marketing_campaign, 
  T.client_first_name = S.client_first_name, T.client_last_name = S.client_last_name, T.client_full_name = S.client_full_name, 
  T.client_email = S.client_email, T.client_phase = S.client_phase, T.opp_owner_id = S.opp_owner_id, 
  T.opp_owner_name = S.opp_owner_name, T.opp_owner_email = S.opp_owner_email, T.opp_pipeline_owner = S.opp_pipeline_owner, 
  T.opp_pipeline_owner_name = S.opp_pipeline_owner_name, T.opp_created_date = S.opp_created_date, 
  T.opportunity_matched = S.opportunity_matched

-- INSERT NEW
WHEN NOT MATCHED THEN INSERT (
  sf_record_id, source_object, bq_source_table, account_id, owner_id, record_type_id, who_id, what_id,
  subject, description, activity_type, event_subtype, task_subtype, disposition, status, priority,
  start_datetime, end_datetime, completed_datetime, duration_minutes, consult_attorney, consult_type, 
  consult_location, consult_date, original_consult_attorney, original_consult_datetime, original_consult_location,
  reschedule_reason, reschedule_notes, location, google_meet_link, zoom_link, zoom_passcode, meeting_room,
  owner_role, attorney_name, assigned_to, client_mobile, company_name, nps_score, review_score, review_comments, 
  reviewed_site, state, notes, next_steps, text_message, is_recurring, is_all_day, is_group_event, is_deleted, 
  is_archived, created_by_id, created_date, last_modified_by_id, last_modified_date, system_modstamp, 
  old_org_record_id, external_sync_id, email_parent_id, email_activity_id, email_text_body, email_html_body, 
  email_headers, email_name, email_from_name, email_from_address, email_validated_from_address, email_to_address, 
  email_cc_address, email_bcc_address, email_incoming, email_has_attachment, email_message_date, 
  email_reply_to_email_message_id, email_is_private_draft, email_is_externally_visible, email_message_identifier, 
  email_thread_identifier, email_client_thread_identifier, email_from_id, email_is_client_managed, 
  email_attachment_ids, email_related_to_id, email_is_tracked, email_is_opened, email_first_opened_date, 
  email_last_opened_date, email_is_bounced, email_template_id, email_routing_address_id, email_automation_type, 
  email_source, matter_is_7_years, matter_complete_date_from_opp, bq_loaded_at, opportunity_id, opportunity_name, 
  stage_name, is_closed, is_won, opp_consult_type, opp_consult_status, opp_consult_datetime, opp_consult_attorney, 
  opp_consult_location, opp_type_of_matter, opp_case_code, opp_lead_source, opp_marketing_source, 
  opp_marketing_campaign, client_first_name, client_last_name, client_full_name, client_email, client_phase,
  opp_owner_id, opp_owner_name, opp_owner_email, opp_pipeline_owner, opp_pipeline_owner_name, opp_created_date,
  opportunity_matched
)
VALUES (
  S.sf_record_id, S.source_object, S.bq_source_table, S.account_id, S.owner_id, S.record_type_id, S.who_id, S.what_id,
  S.subject, S.description, S.activity_type, S.event_subtype, S.task_subtype, S.disposition, S.status, S.priority,
  S.start_datetime, S.end_datetime, S.completed_datetime, S.duration_minutes, S.consult_attorney, S.consult_type, 
  S.consult_location, S.consult_date, S.original_consult_attorney, S.original_consult_datetime, S.original_consult_location,
  S.reschedule_reason, S.reschedule_notes, S.location, S.google_meet_link, S.zoom_link, S.zoom_passcode, S.meeting_room,
  S.owner_role, S.attorney_name, S.assigned_to, S.client_mobile, S.company_name, S.nps_score, S.review_score, S.review_comments, 
  S.reviewed_site, S.state, S.notes, S.next_steps, S.text_message, S.is_recurring, S.is_all_day, S.is_group_event, S.is_deleted, 
  S.is_archived, S.created_by_id, S.created_date, S.last_modified_by_id, S.last_modified_date, S.system_modstamp, 
  S.old_org_record_id, S.external_sync_id, S.email_parent_id, S.email_activity_id, S.email_text_body, S.email_html_body, 
  S.email_headers, S.email_name, S.email_from_name, S.email_from_address, S.email_validated_from_address, S.email_to_address, 
  S.email_cc_address, S.email_bcc_address, S.email_incoming, S.email_has_attachment, S.email_message_date, 
  S.email_reply_to_email_message_id, S.email_is_private_draft, S.email_is_externally_visible, S.email_message_identifier, 
  S.email_thread_identifier, S.email_client_thread_identifier, S.email_from_id, S.email_is_client_managed, 
  S.email_attachment_ids, S.email_related_to_id, S.email_is_tracked, S.email_is_opened, S.email_first_opened_date, 
  S.email_last_opened_date, S.email_is_bounced, S.email_template_id, S.email_routing_address_id, S.email_automation_type, 
  S.email_source, S.matter_is_7_years, S.matter_complete_date_from_opp, S.bq_loaded_at, S.opportunity_id, S.opportunity_name, 
