CREATE OR REPLACE TABLE `rc-datamart-report-082025.callrail_slo.fct_callrail_slo` AS
WITH src AS (
  SELECT
    *,
    COALESCE(
      SAFE.TIMESTAMP_SECONDS(SAFE_CAST(unix_time AS INT64)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', CAST(called_at AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', CAST(called_at AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', CAST(called_at AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d', CAST(called_at AS STRING))
    ) AS called_ts
  FROM `focused-sentry-464713-u0.calltracking_slo.ctp_initialdata_delta`
)
 
SELECT
  *
FROM src
WHERE
  -- Inbound only
  LOWER(COALESCE(direction, '')) = 'inbound'
  -- Duration >= 4 seconds
  AND COALESCE(SAFE_CAST(duration AS INT64), 0) >= 4
  -- Valid, non-banned source
  AND source IS NOT NULL
  AND REGEXP_REPLACE(CAST(source AS STRING), r'[\s\p{Zs}\p{Zl}\p{Zp}]+', '') <> ''
  AND LOWER(TRIM(source)) NOT IN (
    'pbn','agent','agent - css','dead nap','consult recordings',
    'credit card authorization recordings'
  )

  AND NOT REGEXP_CONTAINS(LOWER(COALESCE(tag_list, '')), r'\bspam\b')

  AND called_ts IS NOT NULL

  AND EXTRACT(DAYOFWEEK FROM called_ts AT TIME ZONE "America/Chicago") NOT IN (1,7)

  AND EXTRACT(HOUR FROM called_ts AT TIME ZONE "America/Chicago") BETWEEN 8 AND 17

;
