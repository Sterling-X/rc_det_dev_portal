-- config {
--   "type": "table",
--   "schema": "callrail_slo",
--   "name": "fct_callrail_slo",
--   "description": "Inbound weekday calls, duration >= 4s, exclude unwanted sources and spam tags."
-- }

CREATE OR REPLACE TABLE `rc-datamart-report-082025.callrail_slo.fct_callrail_slo` AS
WITH src AS (
SELECT
*,COALESCE(
SAFE.TIMESTAMP_SECONDS(CAST(unix_time AS INT64)),
SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', called_at),
SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', called_at),
SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', called_at),
SAFE.PARSE_TIMESTAMP('%Y-%m-%d', called_at)
) AS called_ts
FROM
`focused-sentry-464713-u0.calltracking_slo.ctp_initialdata_delta`
)

SELECT
*
FROM
src
WHERE
-- 1) Direction = inbound
LOWER(COALESCE(direction, '')) = 'inbound'

-- 2) Duration >= 4 (treat NULL as 0)
AND COALESCE(CAST(duration AS INT64), 0) >= 4

-- 3) Exclude unwanted tracking sources and exclude NULL/blank/whitespace-only sources
AND source IS NOT NULL
AND TRIM(source) <> ''
AND LOWER(TRIM(source)) NOT IN (
'pbn',
'agent',
'agent - css',
'dead nap',
'consult recordings',
'credit card authorization recordings'
)

-- 4) Exclude tag_list rows containing the word "spam"
-- tag_list in your schema is a string (example: '["new caller","spam"]'), so we defensively check for the word boundary.
AND NOT REGEXP_CONTAINS(LOWER(COALESCE(tag_list, '')), r'\bspam\b')

-- 5) Exclude weekends
-- NOTE: BigQuery EXTRACT(DAYOFWEEK FROM TIMESTAMP) returns 1 = Sunday, 7 = Saturday.
-- We therefore exclude dayofweek IN (1, 7) which corresponds to Sunday and Saturday.
AND (
called_ts IS NOT NULL
AND EXTRACT(DAYOFWEEK FROM called_ts) NOT IN (1, 7)
);
