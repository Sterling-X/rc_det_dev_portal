CREATE OR REPLACE TABLE 
  `rc-datamart-report-082025.genesis_looker_crm_ctp_universal_table.tmp_historical_combined` AS

WITH base AS (
  SELECT * 
  FROM `rc-datamart-report-082025.genesis_looker_crm_ctp_universal_table.tmp_historical_base`
    WHERE NOT (
    Firm_Unique_ID = 'SterlingLawOffice-1010'
    AND Firm_Name  = 'Sterling Lawyers'
  )
),

anchor AS (
  SELECT DISTINCT
    metric_date, date_window, Firm_Unique_ID, Firm_Name, Marketing_Channel
  FROM base
),

-- Answer Rate = Answered Calls / Total Calls
answer_rate AS (
  SELECT
    a.metric_date,
    a.date_window,
    a.Firm_Unique_ID,
    a.Firm_Name,
    a.Marketing_Channel,
    'Answer Rate' AS metric_name,
    SAFE_DIVIDE(ans.metric_value, tc.metric_value) AS metric_value
  FROM anchor a
  LEFT JOIN base ans 
    ON  a.metric_date     = ans.metric_date
    AND a.date_window     = ans.date_window
    AND a.Firm_Unique_ID  = ans.Firm_Unique_ID
    AND a.Firm_Name       = ans.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM ans.Marketing_Channel
    AND ans.metric_name   = 'Answered Calls'
  LEFT JOIN base tc 
    ON  a.metric_date     = tc.metric_date
    AND a.date_window     = tc.date_window
    AND a.Firm_Unique_ID  = tc.Firm_Unique_ID
    AND a.Firm_Name       = tc.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM tc.Marketing_Channel
    AND tc.metric_name    = 'Total Calls'
),

-- Inbound Lead to Call = Calls / Inbound Leads
inbound_lead_to_call AS (
  SELECT
    a.metric_date,
    a.date_window,
    a.Firm_Unique_ID,
    a.Firm_Name,
    a.Marketing_Channel,
    'Inbound Lead to Call' AS metric_name,
    SAFE_DIVIDE(tc.metric_value, inbound.metric_value) AS metric_value
  FROM anchor a
  LEFT JOIN base tc 
    ON  a.metric_date     = tc.metric_date
    AND a.date_window     = tc.date_window
    AND a.Firm_Unique_ID  = tc.Firm_Unique_ID
    AND a.Firm_Name       = tc.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM tc.Marketing_Channel
    AND tc.metric_name    = 'Total Calls'
  LEFT JOIN base inbound 
    ON  a.metric_date     = inbound.metric_date
    AND a.date_window     = inbound.date_window
    AND a.Firm_Unique_ID  = inbound.Firm_Unique_ID
    AND a.Firm_Name       = inbound.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM inbound.Marketing_Channel
    AND inbound.metric_name = 'Inbound Leads'
),

-- QPC Rate = QPCs / Total Leads
qpc_rate AS (
  SELECT
    a.metric_date,
    a.date_window,
    a.Firm_Unique_ID,
    a.Firm_Name,
    a.Marketing_Channel,
    'QPC Rate' AS metric_name,
    SAFE_DIVIDE(qpc.metric_value, tl.metric_value) AS metric_value
  FROM anchor a
  LEFT JOIN base qpc 
    ON  a.metric_date     = qpc.metric_date
    AND a.date_window     = qpc.date_window
    AND a.Firm_Unique_ID  = qpc.Firm_Unique_ID
    AND a.Firm_Name       = qpc.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM qpc.Marketing_Channel
    AND qpc.metric_name   = 'QPCs'
  LEFT JOIN base tl 
    ON  a.metric_date     = tl.metric_date
    AND a.date_window     = tl.date_window
    AND a.Firm_Unique_ID  = tl.Firm_Unique_ID
    AND a.Firm_Name       = tl.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM tl.Marketing_Channel
    AND tl.metric_name    = 'Total Leads'
),

-- QPC to Scheduled = Consults Scheduled / QPCs
qpc_to_scheduled AS (
  SELECT
    a.metric_date,
    a.date_window,
    a.Firm_Unique_ID,
    a.Firm_Name,
    a.Marketing_Channel,
    'QPC to Scheduled' AS metric_name,
    SAFE_DIVIDE(cs.metric_value, qpc.metric_value) AS metric_value
  FROM anchor a
  LEFT JOIN base cs 
    ON  a.metric_date     = cs.metric_date
    AND a.date_window     = cs.date_window
    AND a.Firm_Unique_ID  = cs.Firm_Unique_ID
    AND a.Firm_Name       = cs.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM cs.Marketing_Channel
    AND cs.metric_name    = 'Consults Scheduled'
  LEFT JOIN base qpc 
    ON  a.metric_date     = qpc.metric_date
    AND a.date_window     = qpc.date_window
    AND a.Firm_Unique_ID  = qpc.Firm_Unique_ID
    AND a.Firm_Name       = qpc.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM qpc.Marketing_Channel
    AND qpc.metric_name   = 'QPCs'
),

-- Completion Rate = Consults Completed / Consults Scheduled
completion_rate AS (
  SELECT
    a.metric_date,
    a.date_window,
    a.Firm_Unique_ID,
    a.Firm_Name,
    a.Marketing_Channel,
    'Completion Rate' AS metric_name,
    SAFE_DIVIDE(cc.metric_value, cs.metric_value) AS metric_value
  FROM anchor a
  LEFT JOIN base cc 
    ON  a.metric_date     = cc.metric_date
    AND a.date_window     = cc.date_window
    AND a.Firm_Unique_ID  = cc.Firm_Unique_ID
    AND a.Firm_Name       = cc.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM cc.Marketing_Channel
    AND cc.metric_name    = 'Consults Completed'
  LEFT JOIN base cs 
    ON  a.metric_date     = cs.metric_date
    AND a.date_window     = cs.date_window
    AND a.Firm_Unique_ID  = cs.Firm_Unique_ID
    AND a.Firm_Name       = cs.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM cs.Marketing_Channel
    AND cs.metric_name    = 'Consults Scheduled'
),

-- Quote Rate = Quotes / Consults Completed
quote_rate AS (
  SELECT
    a.metric_date,
    a.date_window,
    a.Firm_Unique_ID,
    a.Firm_Name,
    a.Marketing_Channel,
    'Quote Rate' AS metric_name,
    SAFE_DIVIDE(qt.metric_value, cc.metric_value) AS metric_value
  FROM anchor a
  LEFT JOIN base qt 
    ON  a.metric_date     = qt.metric_date
    AND a.date_window     = qt.date_window
    AND a.Firm_Unique_ID  = qt.Firm_Unique_ID
    AND a.Firm_Name       = qt.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM qt.Marketing_Channel
    AND qt.metric_name    = 'Quotes'
  LEFT JOIN base cc 
    ON  a.metric_date     = cc.metric_date
    AND a.date_window     = cc.date_window
    AND a.Firm_Unique_ID  = cc.Firm_Unique_ID
    AND a.Firm_Name       = cc.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM cc.Marketing_Channel
    AND cc.metric_name    = 'Consults Completed'
),

-- Close Rate = Funded Agreements / Consults Scheduled
close_rate AS (
  SELECT
    a.metric_date,
    a.date_window,
    a.Firm_Unique_ID,
    a.Firm_Name,
    a.Marketing_Channel,
    'Close Rate' AS metric_name,
    SAFE_DIVIDE(fa.metric_value, cs.metric_value) AS metric_value
  FROM anchor a
  LEFT JOIN base fa 
    ON  a.metric_date     = fa.metric_date
    AND a.date_window     = fa.date_window
    AND a.Firm_Unique_ID  = fa.Firm_Unique_ID
    AND a.Firm_Name       = fa.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM fa.Marketing_Channel
    AND fa.metric_name    = 'Funded Agreements'
  LEFT JOIN base cs 
    ON  a.metric_date     = cs.metric_date
    AND a.date_window     = cs.date_window
    AND a.Firm_Unique_ID  = cs.Firm_Unique_ID
    AND a.Firm_Name       = cs.Firm_Name
    AND a.Marketing_Channel IS NOT DISTINCT FROM cs.Marketing_Channel
    AND cs.metric_name    = 'Consults Scheduled'
)

SELECT * FROM answer_rate
UNION ALL SELECT * FROM inbound_lead_to_call
UNION ALL SELECT * FROM qpc_rate
UNION ALL SELECT * FROM qpc_to_scheduled
UNION ALL SELECT * FROM completion_rate
UNION ALL SELECT * FROM quote_rate
UNION ALL SELECT * FROM close_rate;
