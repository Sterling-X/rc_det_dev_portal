CREATE OR REPLACE TABLE
  `rc-datamart-report-082025.genesis_looker_crm_ctp_universal_table.tmp_historical_base` AS

-- 0) Firm → timezone map (no change)
WITH firm_tz AS (
  SELECT 'VDL-vdl1001'               AS Firm_Unique_ID, 'America/Chicago' AS tz UNION ALL
  SELECT 'SMB-smb1002'               AS Firm_Unique_ID, 'America/Chicago' AS tz UNION ALL
  SELECT 'Brucelaw-blg-1003'         AS Firm_Unique_ID, 'America/Chicago' AS tz UNION ALL
  SELECT 'Rosenblum-ral1004'         AS Firm_Unique_ID, 'America/Chicago' AS tz UNION ALL
  SELECT 'meyerpinklaw-mpl1005'      AS Firm_Unique_ID, 'America/Chicago' AS tz UNION ALL
  SELECT 'sumitfamilylawinc-sfl1006' AS Firm_Unique_ID, 'America/Chicago' AS tz UNION ALL
  SELECT 'auritmediation-am1007'     AS Firm_Unique_ID, 'America/Chicago' AS tz UNION ALL
  SELECT 'drakelaw-dl1008'           AS Firm_Unique_ID, 'America/Chicago' AS tz UNION ALL
  SELECT 'haffner-haffner1009'       AS Firm_Unique_ID, 'America/Chicago' AS tz UNION ALL
  SELECT 'theramagelawgroup-1011'    AS Firm_Unique_ID, 'America/Chicago' AS tz UNION ALL
  SELECT 'chisholmlawfirm-1012'      AS Firm_Unique_ID, 'America/Chicago' AS tz
),

-- 1) Date spine: full calendar (no change)
date_spine AS (
  SELECT d AS metric_date
  FROM UNNEST(GENERATE_DATE_ARRAY(DATE('2022-01-01'), CURRENT_DATE())) AS d
),

-- 2) Distinct firms (non-Sterling) with timezone (no change)
firms AS (
  SELECT DISTINCT
    u.Firm_Unique_ID,
    u.Firm_Name,
    COALESCE(tz.tz, 'UTC') AS tz
  FROM `rc-datamart-report-082025.genesis_looker_crm_ctp_universal_table.genesis_crm_ctp_universal_table` u
  LEFT JOIN firm_tz tz USING (Firm_Unique_ID)
  WHERE NOT (
    u.Firm_Unique_ID = 'SterlingLawOffice-1010'
    AND u.Firm_Name  = 'Sterling Lawyers'
  )
),

-- 3) Static marketing channel spine (8 labels including Null)
channel_spine AS (
  SELECT 'Agent'           AS Marketing_Channel UNION ALL
  SELECT 'Other'                                  UNION ALL
  SELECT 'Paid Search'                            UNION ALL
  SELECT 'Local SEO'                              UNION ALL
  SELECT 'Direct'                                 UNION ALL
  SELECT 'Prospecting'                            UNION ALL
  SELECT 'Traditional SEO'                        UNION ALL
  SELECT 'Null'
),

-- 4) Firm × Channel combinations using static spine (non-Sterling)
firm_channels AS (
  SELECT
    f.Firm_Unique_ID,
    f.Firm_Name,
    c.Marketing_Channel
  FROM firms f
  CROSS JOIN channel_spine c
),

firm_channel_tz AS (
  SELECT
    fc.Firm_Unique_ID,
    fc.Firm_Name,
    fc.Marketing_Channel,
    f.tz
  FROM firm_channels fc
  JOIN firms f
    ON f.Firm_Unique_ID = fc.Firm_Unique_ID
   AND f.Firm_Name      = fc.Firm_Name
),

-- Helper CASE mapping for channel 
-- CASE
--   WHEN u.Marketing_Channel_Universal IS NULL
--        OR TRIM(CAST(u.Marketing_Channel_Universal AS STRING)) = '' THEN 'Null'
--   WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'agent'
--     THEN 'Agent'
--   WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'other'
--     THEN 'Other'
--   WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('paid search','paid_search','ppc')
--     THEN 'Paid Search'
--   WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('local seo','local_seo','gmb','gmb - organic')
--     THEN 'Local SEO'
--   WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'direct'
--     THEN 'Direct'
--   WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'prospecting'
--     THEN 'Prospecting'
--   WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('traditional seo','seo','organic')
--     THEN 'Traditional SEO'
--   ELSE 'Other'
-- END

-- 5) Daily CALL metrics per firm + channel (mapped to static buckets)
calls_daily AS (
  SELECT
    u.Firm_Unique_ID,
    u.Firm_Name,
    CASE
      WHEN u.Marketing_Channel_Universal IS NULL
           OR TRIM(CAST(u.Marketing_Channel_Universal AS STRING)) = '' THEN 'Null'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'agent'
        THEN 'Agent'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'other'
        THEN 'Other'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('paid search', 'paid_search', 'ppc')
        THEN 'Paid Search'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('local seo', 'local_seo', 'gmb', 'gmb - organic')
        THEN 'Local SEO'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'direct'
        THEN 'Direct'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'prospecting'
        THEN 'Prospecting'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('traditional seo','seo','organic')
        THEN 'Traditional SEO'
      ELSE 'Other'
    END AS Marketing_Channel,
    DATE(DATETIME(u.start_datetime, f.tz)) AS metric_date,
    COUNT(u.Call_Tracking_Unique_ID) AS calls_total_day,
    SUM(CASE WHEN SAFE_CAST(u.Answered AS BOOL) THEN 1 ELSE 0 END) AS calls_answered_day
  FROM `rc-datamart-report-082025.genesis_looker_crm_ctp_universal_table.genesis_crm_ctp_universal_table` u
  JOIN firms f
    ON f.Firm_Unique_ID = u.Firm_Unique_ID
   AND f.Firm_Name      = u.Firm_Name
  WHERE u.start_datetime IS NOT NULL
  GROUP BY u.Firm_Unique_ID, u.Firm_Name, Marketing_Channel, metric_date
),

-- 6) Daily LEAD metrics per firm + channel (mapped buckets)
leads_daily AS (
  SELECT 
    u.Firm_Unique_ID,
    u.Firm_Name,
    CASE
      WHEN u.Marketing_Channel_Universal IS NULL
           OR TRIM(CAST(u.Marketing_Channel_Universal AS STRING)) = '' THEN 'Null'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'agent'
        THEN 'Agent'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'other'
        THEN 'Other'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('paid search', 'paid_search', 'ppc')
        THEN 'Paid Search'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('local seo', 'local_seo', 'gmb', 'gmb - organic')
        THEN 'Local SEO'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'direct'
        THEN 'Direct'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'prospecting'
        THEN 'Prospecting'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('traditional seo','seo','organic')
        THEN 'Traditional SEO'
      ELSE 'Other'
    END AS Marketing_Channel,
    SAFE_CAST(u.Lead_Create_Date AS DATE) AS metric_date,
    COUNT(DISTINCT u.Lead_Unique_ID) AS leads_total_day,
    COUNT(DISTINCT CASE WHEN u.Web_Lead_Indicator IS NOT NULL THEN u.Lead_Unique_ID END) AS web_leads_day
  FROM `rc-datamart-report-082025.genesis_looker_crm_ctp_universal_table.genesis_crm_ctp_universal_table` u
  JOIN firms f
    ON f.Firm_Unique_ID = u.Firm_Unique_ID
   AND f.Firm_Name      = u.Firm_Name
  WHERE u.Lead_Create_Date IS NOT NULL
    AND u.Lead_Unique_ID IS NOT NULL
  GROUP BY u.Firm_Unique_ID, u.Firm_Name, Marketing_Channel, metric_date
),

-- 7) QPC per firm + channel (mapped buckets)
qpc_daily AS (
  SELECT
    u.Firm_Unique_ID,
    u.Firm_Name,
    CASE
      WHEN u.Marketing_Channel_Universal IS NULL
           OR TRIM(CAST(u.Marketing_Channel_Universal AS STRING)) = '' THEN 'Null'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'agent'
        THEN 'Agent'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'other'
        THEN 'Other'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('paid search', 'paid_search', 'ppc')
        THEN 'Paid Search'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('local seo', 'local_seo', 'gmb', 'gmb - organic')
        THEN 'Local SEO'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'direct'
        THEN 'Direct'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'prospecting'
        THEN 'Prospecting'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('traditional seo','seo','organic')
        THEN 'Traditional SEO'
      ELSE 'Other'
    END AS Marketing_Channel,
    SAFE_CAST(u.QPC AS DATE) AS metric_date,
    COUNT(*) AS qpc_count_day
  FROM `rc-datamart-report-082025.genesis_looker_crm_ctp_universal_table.genesis_crm_ctp_universal_table` u
  JOIN firms f
    ON f.Firm_Unique_ID = u.Firm_Unique_ID
   AND f.Firm_Name      = u.Firm_Name
  WHERE u.QPC IS NOT NULL
  GROUP BY u.Firm_Unique_ID, u.Firm_Name, Marketing_Channel, metric_date
),

-- 8) Other CRM event dates per firm + channel (mapped buckets)
consult_sched_daily AS (
  SELECT
    u.Firm_Unique_ID,
    u.Firm_Name,
    CASE
      WHEN u.Marketing_Channel_Universal IS NULL
           OR TRIM(CAST(u.Marketing_Channel_Universal AS STRING)) = '' THEN 'Null'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'agent'
        THEN 'Agent'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'other'
        THEN 'Other'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('paid search', 'paid_search', 'ppc')
        THEN 'Paid Search'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('local seo', 'local_seo', 'gmb', 'gmb - organic')
        THEN 'Local SEO'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'direct'
        THEN 'Direct'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'prospecting'
        THEN 'Prospecting'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('traditional seo','seo','organic')
        THEN 'Traditional SEO'
      ELSE 'Other'
    END AS Marketing_Channel,
    SAFE_CAST(u.Consultation_Date AS DATE) AS metric_date,
    COUNT(*) AS consults_scheduled_day
  FROM `rc-datamart-report-082025.genesis_looker_crm_ctp_universal_table.genesis_crm_ctp_universal_table` u
  JOIN firms f
    ON f.Firm_Unique_ID = u.Firm_Unique_ID
   AND f.Firm_Name      = u.Firm_Name
  WHERE u.Consultation_Date IS NOT NULL
  GROUP BY u.Firm_Unique_ID, u.Firm_Name, Marketing_Channel, metric_date
),

consult_comp_daily AS (
  SELECT
    u.Firm_Unique_ID,
    u.Firm_Name,
    CASE
      WHEN u.Marketing_Channel_Universal IS NULL
           OR TRIM(CAST(u.Marketing_Channel_Universal AS STRING)) = '' THEN 'Null'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'agent'
        THEN 'Agent'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'other'
        THEN 'Other'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('paid search', 'paid_search', 'ppc')
        THEN 'Paid Search'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('local seo', 'local_seo', 'gmb', 'gmb - organic')
        THEN 'Local SEO'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'direct'
        THEN 'Direct'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'prospecting'
        THEN 'Prospecting'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('traditional seo','seo','organic')
        THEN 'Traditional SEO'
      ELSE 'Other'
    END AS Marketing_Channel,
    SAFE_CAST(u.Consult_Completed_Date AS DATE) AS metric_date,
    COUNT(*) AS consults_completed_day
  FROM `rc-datamart-report-082025.genesis_looker_crm_ctp_universal_table.genesis_crm_ctp_universal_table` u
  JOIN firms f
    ON f.Firm_Unique_ID = u.Firm_Unique_ID
   AND f.Firm_Name      = u.Firm_Name
  WHERE u.Consult_Completed_Date IS NOT NULL
  GROUP BY u.Firm_Unique_ID, u.Firm_Name, Marketing_Channel, metric_date
),

quotes_daily AS (
  SELECT
    u.Firm_Unique_ID,
    u.Firm_Name,
    CASE
      WHEN u.Marketing_Channel_Universal IS NULL
           OR TRIM(CAST(u.Marketing_Channel_Universal AS STRING)) = '' THEN 'Null'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'agent'
        THEN 'Agent'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'other'
        THEN 'Other'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('paid search', 'paid_search', 'ppc')
        THEN 'Paid Search'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('local seo', 'local_seo', 'gmb', 'gmb - organic')
        THEN 'Local SEO'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'direct'
        THEN 'Direct'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'prospecting'
        THEN 'Prospecting'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('traditional seo','seo','organic')
        THEN 'Traditional SEO'
      ELSE 'Other'
    END AS Marketing_Channel,
    SAFE_CAST(u.Retainer_Sent_Date AS DATE) AS metric_date,
    COUNT(*) AS quotes_day
  FROM `rc-datamart-report-082025.genesis_looker_crm_ctp_universal_table.genesis_crm_ctp_universal_table` u
  JOIN firms f
    ON f.Firm_Unique_ID = u.Firm_Unique_ID
   AND f.Firm_Name      = u.Firm_Name
  WHERE u.Retainer_Sent_Date IS NOT NULL
  GROUP BY u.Firm_Unique_ID, u.Firm_Name, Marketing_Channel, metric_date
),

funded_daily AS (
  SELECT
    u.Firm_Unique_ID,
    u.Firm_Name,
    CASE
      WHEN u.Marketing_Channel_Universal IS NULL
           OR TRIM(CAST(u.Marketing_Channel_Universal AS STRING)) = '' THEN 'Null'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'agent'
        THEN 'Agent'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'other'
        THEN 'Other'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('paid search', 'paid_search', 'ppc')
        THEN 'Paid Search'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('local seo', 'local_seo', 'gmb', 'gmb - organic')
        THEN 'Local SEO'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'direct'
        THEN 'Direct'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) = 'prospecting'
        THEN 'Prospecting'
      WHEN LOWER(TRIM(CAST(u.Marketing_Channel_Universal AS STRING))) IN ('traditional seo','seo','organic')
        THEN 'Traditional SEO'
      ELSE 'Other'
    END AS Marketing_Channel,
    SAFE_CAST(u.Retainer_Funded_Date AS DATE) AS metric_date,
    COUNT(*) AS funded_agreements_day
  FROM `rc-datamart-report-082025.genesis_looker_crm_ctp_universal_table.genesis_crm_ctp_universal_table` u
  JOIN firms f
    ON f.Firm_Unique_ID = u.Firm_Unique_ID
   AND f.Firm_Name      = u.Firm_Name
  WHERE u.Retainer_Funded_Date IS NOT NULL
  GROUP BY u.Firm_Unique_ID, u.Firm_Name, Marketing_Channel, metric_date
),

-- 9) Dense firm + channel + date grid with zero-filling
dense AS (
  SELECT
    fct.Firm_Unique_ID,
    fct.Firm_Name,
    fct.tz,
    fct.Marketing_Channel,
    d.metric_date,
    COALESCE(c.calls_total_day, 0)         AS calls_total_day,
    COALESCE(c.calls_answered_day, 0)      AS calls_answered_day,
    COALESCE(l.leads_total_day, 0)         AS leads_total_day,
    COALESCE(l.web_leads_day, 0)           AS web_leads_day,
    COALESCE(q.qpc_count_day, 0)           AS qpc_count_day,
    COALESCE(cs.consults_scheduled_day, 0) AS consults_scheduled_day,
    COALESCE(cc.consults_completed_day, 0) AS consults_completed_day,
    COALESCE(qu.quotes_day, 0)             AS quotes_day,
    COALESCE(fu.funded_agreements_day, 0)  AS funded_agreements_day
  FROM firm_channel_tz fct
  CROSS JOIN date_spine d
  LEFT JOIN calls_daily c
    ON c.Firm_Unique_ID = fct.Firm_Unique_ID
   AND c.Firm_Name      = fct.Firm_Name
   AND c.metric_date    = d.metric_date
   AND c.Marketing_Channel IS NOT DISTINCT FROM fct.Marketing_Channel
  LEFT JOIN leads_daily l
    ON l.Firm_Unique_ID = fct.Firm_Unique_ID
   AND l.Firm_Name      = fct.Firm_Name
   AND l.metric_date    = d.metric_date
   AND l.Marketing_Channel IS NOT DISTINCT FROM fct.Marketing_Channel
  LEFT JOIN qpc_daily q
    ON q.Firm_Unique_ID = fct.Firm_Unique_ID
   AND q.Firm_Name      = fct.Firm_Name
   AND q.metric_date    = d.metric_date
   AND q.Marketing_Channel IS NOT DISTINCT FROM fct.Marketing_Channel
  LEFT JOIN consult_sched_daily cs
    ON cs.Firm_Unique_ID = fct.Firm_Unique_ID
   AND cs.Firm_Name      = fct.Firm_Name
   AND cs.metric_date    = d.metric_date
   AND cs.Marketing_Channel IS NOT DISTINCT FROM fct.Marketing_Channel
  LEFT JOIN consult_comp_daily cc
    ON cc.Firm_Unique_ID = fct.Firm_Unique_ID
   AND cc.Firm_Name      = fct.Firm_Name
   AND cc.metric_date    = d.metric_date
   AND cc.Marketing_Channel IS NOT DISTINCT FROM fct.Marketing_Channel
  LEFT JOIN quotes_daily qu
    ON qu.Firm_Unique_ID = fct.Firm_Unique_ID
   AND qu.Firm_Name      = fct.Firm_Name
   AND qu.metric_date    = d.metric_date
   AND qu.Marketing_Channel IS NOT DISTINCT FROM fct.Marketing_Channel
  LEFT JOIN funded_daily fu
    ON fu.Firm_Unique_ID = fct.Firm_Unique_ID
   AND fu.Firm_Name      = fct.Firm_Name
   AND fu.metric_date    = d.metric_date
   AND fu.Marketing_Channel IS NOT DISTINCT FROM fct.Marketing_Channel
),

-- 10) Rolling windows per firm + channel
roll AS (
  SELECT
    *,
    -- Calls
    SUM(calls_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS calls_w7,
    SUM(calls_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS calls_w28,
    SUM(calls_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS calls_w90,
    SUM(calls_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS calls_w180,
    SUM(calls_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS calls_w365,

    -- Answered calls
    SUM(calls_answered_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS ans_w7,
    SUM(calls_answered_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS ans_w28,
    SUM(calls_answered_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS ans_w90,
    SUM(calls_answered_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS ans_w180,
    SUM(calls_answered_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS ans_w365,

    -- Leads
    SUM(leads_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS leads_w7,
    SUM(leads_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS leads_w28,
    SUM(leads_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS leads_w90,
    SUM(leads_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS leads_w180,
    SUM(leads_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS leads_w365,

    -- Web leads
    SUM(web_leads_day)      OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS web_w7,
    SUM(web_leads_day)      OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS web_w28,
    SUM(web_leads_day)      OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS web_w90,
    SUM(web_leads_day)      OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS web_w180,
    SUM(web_leads_day)      OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS web_w365,

    -- QPC
    SUM(qpc_count_day)      OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS qpc_w7,
    SUM(qpc_count_day)      OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS qpc_w28,
    SUM(qpc_count_day)      OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS qpc_w90,
    SUM(qpc_count_day)      OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS qpc_w180,
    SUM(qpc_count_day)      OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS qpc_w365,

    -- Consults scheduled
    SUM(consults_scheduled_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS cs_w7,
    SUM(consults_scheduled_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS cs_w28,
    SUM(consults_scheduled_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS cs_w90,
    SUM(consults_scheduled_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS cs_w180,
    SUM(consults_scheduled_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS cs_w365,

    -- Consults completed
    SUM(consults_completed_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS cc_w7,
    SUM(consults_completed_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS cc_w28,
    SUM(consults_completed_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS cc_w90,
    SUM(consults_completed_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS cc_w180,
    SUM(consults_completed_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS cc_w365,

    -- Quotes
    SUM(quotes_day)             OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS qts_w7,
    SUM(quotes_day)             OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS qts_w28,
    SUM(quotes_day)             OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS qts_w90,
    SUM(quotes_day)             OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS qts_w180,
    SUM(quotes_day)             OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS qts_w365,

    -- Funded agreements
    SUM(funded_agreements_day)  OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS fa_w7,
    SUM(funded_agreements_day)  OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS fa_w28,
    SUM(funded_agreements_day)  OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS fa_w90,
    SUM(funded_agreements_day)  OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS fa_w180,
    SUM(funded_agreements_day)  OVER (PARTITION BY Firm_Unique_ID, Firm_Name, Marketing_Channel ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS fa_w365
  FROM dense
)

-- 11) Output: tall metric table per firm + channel
SELECT
  r.metric_date,
  m.date_window,
  r.Firm_Unique_ID,
  r.Firm_Name,
  r.Marketing_Channel,
  m.metric_name,
ROUND(
  CASE
    WHEN r.Firm_Unique_ID = 'chisholmlawfirm-1012'
     AND r.Firm_Name      = 'Chisholm Law Firm'
     AND r.metric_date    >= DATE '2026-01-14'
     AND m.metric_name IN (
       'Web Leads',
       'QPCs',
       'Consults Scheduled',
       'Consults Completed',
       'Quotes',
       'Funded Agreements'
     )
     AND (
       (m.date_window = 'last_28_days'   AND r.metric_date < DATE_ADD(DATE '2026-01-14', INTERVAL  28 DAY)) OR
       (m.date_window = 'last_3_months'  AND r.metric_date < DATE_ADD(DATE '2026-01-14', INTERVAL  90 DAY)) OR
       (m.date_window = 'last_6_months'  AND r.metric_date < DATE_ADD(DATE '2026-01-14', INTERVAL 180 DAY)) OR
       (m.date_window = 'last_12_months' AND r.metric_date < DATE_ADD(DATE '2026-01-14', INTERVAL 365 DAY))
     )
    THEN 0.0
    ELSE m.metric_value
  END
, 1) AS metric_value



FROM roll r
CROSS JOIN UNNEST([
  -- Calls
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Calls','last_7_days'   , SAFE_DIVIDE(calls_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Calls','last_28_days'  , SAFE_DIVIDE(calls_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Calls','last_3_months' , SAFE_DIVIDE(calls_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Calls','last_6_months' , SAFE_DIVIDE(calls_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Calls','last_12_months', SAFE_DIVIDE(calls_w365,260)),

  -- Answered calls
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Answered Calls','last_7_days'   , SAFE_DIVIDE(ans_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Answered Calls','last_28_days'  , SAFE_DIVIDE(ans_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Answered Calls','last_3_months' , SAFE_DIVIDE(ans_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Answered Calls','last_6_months' , SAFE_DIVIDE(ans_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Answered Calls','last_12_months', SAFE_DIVIDE(ans_w365,260)),

  -- Total leads
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Leads','last_7_days'   , SAFE_DIVIDE(leads_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Leads','last_28_days'  , SAFE_DIVIDE(leads_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Leads','last_3_months' , SAFE_DIVIDE(leads_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Leads','last_6_months' , SAFE_DIVIDE(leads_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Leads','last_12_months', SAFE_DIVIDE(leads_w365,260)),

  -- Web leads
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Web Leads','last_7_days'   , SAFE_DIVIDE(web_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Web Leads','last_28_days'  , SAFE_DIVIDE(web_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Web Leads','last_3_months' , SAFE_DIVIDE(web_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Web Leads','last_6_months' , SAFE_DIVIDE(web_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Web Leads','last_12_months', SAFE_DIVIDE(web_w365,260)),

  -- Inbound leads (total - web)
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Inbound Leads','last_7_days'   , SAFE_DIVIDE(leads_w7   - web_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Inbound Leads','last_28_days'  , SAFE_DIVIDE(leads_w28  - web_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Inbound Leads','last_3_months' , SAFE_DIVIDE(leads_w90  - web_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Inbound Leads','last_6_months' , SAFE_DIVIDE(leads_w180 - web_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Inbound Leads','last_12_months', SAFE_DIVIDE(leads_w365 - web_w365,260)),

  -- QPC
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('QPCs','last_7_days'   , SAFE_DIVIDE(qpc_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('QPCs','last_28_days'  , SAFE_DIVIDE(qpc_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('QPCs','last_3_months' , SAFE_DIVIDE(qpc_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('QPCs','last_6_months' , SAFE_DIVIDE(qpc_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('QPCs','last_12_months', SAFE_DIVIDE(qpc_w365,260)),

  -- Consults scheduled
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Consults Scheduled','last_7_days'   , SAFE_DIVIDE(cs_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Consults Scheduled','last_28_days'  , SAFE_DIVIDE(cs_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Consults Scheduled','last_3_months' , SAFE_DIVIDE(cs_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Consults Scheduled','last_6_months' , SAFE_DIVIDE(cs_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Consults Scheduled','last_12_months', SAFE_DIVIDE(cs_w365,260)),

  -- Consults completed
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Consults Completed','last_7_days'   , SAFE_DIVIDE(cc_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Consults Completed','last_28_days'  , SAFE_DIVIDE(cc_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Consults Completed','last_3_months' , SAFE_DIVIDE(cc_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Consults Completed','last_6_months' , SAFE_DIVIDE(cc_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Consults Completed','last_12_months', SAFE_DIVIDE(cc_w365,260)),

  -- Quotes
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Quotes','last_7_days'   , SAFE_DIVIDE(qts_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Quotes','last_28_days'  , SAFE_DIVIDE(qts_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Quotes','last_3_months' , SAFE_DIVIDE(qts_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Quotes','last_6_months' , SAFE_DIVIDE(qts_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Quotes','last_12_months', SAFE_DIVIDE(qts_w365,260)),

  -- Funded Agreements
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Funded Agreements','last_7_days'   , SAFE_DIVIDE(fa_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Funded Agreements','last_28_days'  , SAFE_DIVIDE(fa_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Funded Agreements','last_3_months' , SAFE_DIVIDE(fa_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Funded Agreements','last_6_months' , SAFE_DIVIDE(fa_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Funded Agreements','last_12_months', SAFE_DIVIDE(fa_w365,260))
]) AS m;
