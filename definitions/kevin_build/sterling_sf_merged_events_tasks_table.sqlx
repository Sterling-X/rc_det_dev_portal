-- ============================================================
-- CREATE: sterling_sf_datamart.activity_universal
-- Run once — idempotent; skip if table already exists
-- ============================================================

CREATE TABLE IF NOT EXISTS `sterling-lawyers-database.sterling_sf_datamart.activity_universal` (
  sf_record_id              STRING,
  source_object             STRING,
  account_id                STRING,
  owner_id                  STRING,
  record_type_id            STRING,
  subject                   STRING,
  description               STRING,
  activity_type             STRING,
  event_subtype             STRING,   -- EventSubtype (Event only)
  task_subtype              STRING,   -- TaskSubtype  (Task only)
  disposition               STRING,
  status                    STRING,
  priority                  STRING,
  start_datetime            TIMESTAMP,
  end_datetime              TIMESTAMP,
  completed_datetime        TIMESTAMP,
  duration_minutes          INTEGER,
  consult_attorney          STRING,
  consult_type              STRING,
  consult_location          STRING,
  consult_date              DATE,
  original_consult_attorney STRING,
  original_consult_datetime TIMESTAMP,
  original_consult_location STRING,
  reschedule_reason         STRING,
  reschedule_notes          STRING,
  location                  STRING,
  google_meet_link          STRING,
  zoom_link                 STRING,
  zoom_passcode             STRING,
  meeting_room              STRING,
  owner_role                STRING,
  attorney_name             STRING,
  assigned_to               STRING,
  client_mobile             STRING,
  company_name              STRING,
  who_id                    STRING,
  what_id                   STRING,
  nps_score                 FLOAT64,
  review_score              FLOAT64,
  review_comments           STRING,
  reviewed_site             STRING,
  state                     STRING,
  notes                     STRING,
  next_steps                STRING,
  text_message              STRING,
  is_recurring              BOOLEAN,
  is_all_day                BOOLEAN,
  is_group_event            BOOLEAN,
  is_deleted                BOOLEAN,
  is_archived               BOOLEAN,
  created_by_id             STRING,
  created_date              TIMESTAMP,
  last_modified_by_id       STRING,
  last_modified_date        TIMESTAMP,
  system_modstamp           TIMESTAMP,
  old_org_record_id         STRING,
  external_sync_id          STRING,
  bq_loaded_at              TIMESTAMP,
  bq_source_table           STRING
)
PARTITION BY DATE(completed_datetime)
CLUSTER BY source_object, owner_id, consult_type;


-- ============================================================
-- MERGE: activity_universal
-- Sources : sf_tasks_closed  ∪  sf_events_completed
-- PK      : sf_record_id (Salesforce Id — unique across objects)
-- Guard   : WHEN MATCHED only fires if source is strictly newer
-- ============================================================

MERGE `sterling-lawyers-database.sterling_sf_datamart.activity_universal` AS T
USING (

  -- ── TASKS (sf_tasks_closed) ────────────────────────────────
  -- start_datetime    → ActivityDate cast to TIMESTAMP (no ActivityDateTime on Task)
  -- end_datetime      → CompletedDateTime              (no EndDateTime on Task)
  -- completed_datetime→ CompletedDateTime
  -- duration_minutes  → CallDurationInSeconds / 60     (no DurationInMinutes on Task)
  -- is_all_day        → NULL                           (no IsAllDayEvent on Task)
  -- is_group_event    → NULL                           (no IsGroupEvent on Task)
  -- event_subtype     → NULL                           (Task object only has TaskSubtype)
  SELECT
    Id                                                    AS sf_record_id,
    'Task'                                                AS source_object,
    AccountId                                             AS account_id,
    OwnerId                                               AS owner_id,
    RecordTypeId                                          AS record_type_id,
    Subject                                               AS subject,
    Description                                           AS description,
    Type                                                  AS activity_type,
    NULL                                                  AS event_subtype,
    TaskSubtype                                           AS task_subtype,
    Disposition__c                                        AS disposition,
    Status                                                AS status,
    Priority                                              AS priority,
    CAST(ActivityDate AS TIMESTAMP)                       AS start_datetime,
    CompletedDateTime                                     AS end_datetime,
    CompletedDateTime                                     AS completed_datetime,
    CAST(SAFE_DIVIDE(CallDurationInSeconds, 60) AS INT64) AS duration_minutes,
    Consult_Attorney__c                                   AS consult_attorney,
    Consult_Type__c                                       AS consult_type,
    Consultation_Location__c                              AS consult_location,
    Consult_date_only__c                                  AS consult_date,
    Original_Consult_Attorney__c                          AS original_consult_attorney,
    Original_Consult_Date_Time__c                         AS original_consult_datetime,
    Original_Consult_Location__c                          AS original_consult_location,
    Reschedule_Reason__c                                  AS reschedule_reason,
    Reschedule_Notes__c                                   AS reschedule_notes,
    Consult_Location_Address__c                           AS location,
    Google_Meet_Link__c                                   AS google_meet_link,
    Zoom_Link__c                                          AS zoom_link,
    Zoom_Pass_Code_and_Phone__c                           AS zoom_passcode,
    Meeting_Rooms__c                                      AS meeting_room,
    Owner_Role__c                                         AS owner_role,
    Attorney_Name_as_Text__c                              AS attorney_name,
    Assigned_To_PickList__c                               AS assigned_to,
    Client_Mobile_Number__c                               AS client_mobile,
    Company_Name__c                                       AS company_name,
    WhoId                                                 AS who_id,
    WhatId                                                AS what_id,
    NPS_Score__c                                          AS nps_score,
    SAFE_CAST(Review_Score__c AS FLOAT64)                 AS review_score,
    Review_Comments__c                                    AS review_comments,
    Reviewed_Site__c                                      AS reviewed_site,
    State__c                                              AS state,
    Notes__c                                              AS notes,
    CAST(Next_Steps_Value__c AS STRING)                   AS next_steps,
    Text_Message__c                                       AS text_message,
    IsRecurrence                                          AS is_recurring,
    NULL                                                  AS is_all_day,
    NULL                                                  AS is_group_event,
    IsDeleted                                             AS is_deleted,
    IsArchived                                            AS is_archived,
    CreatedById                                           AS created_by_id,
    CreatedDate                                           AS created_date,
    LastModifiedById                                      AS last_modified_by_id,
    LastModifiedDate                                      AS last_modified_date,
    SystemModstamp                                        AS system_modstamp,
    OldOrg_Record_ID__c                                   AS old_org_record_id,
    External_Sync_Id__c                                   AS external_sync_id,
    CURRENT_TIMESTAMP()                                   AS bq_loaded_at,
    'sf_tasks_closed'                                     AS bq_source_table

  FROM `sterling-lawyers-database.sterling_sf_staging.sf_tasks_closed`

  UNION ALL

  -- ── EVENTS (sf_events_completed) ──────────────────────────
  -- start_datetime    → COALESCE(ActivityDateTime, StartDateTime, ActivityDate cast)
  -- end_datetime      → EndDateTime
  -- completed_datetime→ EndDateTime                    (no CompletedDateTime on Event)
  -- duration_minutes  → DurationInMinutes
  -- status            → derived via CASE on EndDateTime(no Status on Event)
  -- priority          → NULL                           (no Priority on Event)
  -- task_subtype      → NULL                           (Event object only has EventSubtype)
  SELECT
    Id                                                    AS sf_record_id,
    'Event'                                               AS source_object,
    AccountId                                             AS account_id,
    OwnerId                                               AS owner_id,
    RecordTypeId                                          AS record_type_id,
    Subject                                               AS subject,
    Description                                           AS description,
    Type                                                  AS activity_type,
    EventSubtype                                          AS event_subtype,
    NULL                                                  AS task_subtype,
    Disposition__c                                        AS disposition,
    CASE
      WHEN EndDateTime <= CURRENT_TIMESTAMP() THEN 'Completed'
      WHEN StartDateTime > CURRENT_TIMESTAMP() THEN 'Scheduled'
      ELSE 'In Progress'
    END                                                   AS status,
    NULL                                                  AS priority,
    COALESCE(
      ActivityDateTime,
      StartDateTime,
      CAST(ActivityDate AS TIMESTAMP)
    )                                                     AS start_datetime,
    EndDateTime                                           AS end_datetime,
    EndDateTime                                           AS completed_datetime,
    DurationInMinutes                                     AS duration_minutes,
    Consult_Attorney__c                                   AS consult_attorney,
    Consult_Type__c                                       AS consult_type,
    Consultation_Location__c                              AS consult_location,
    Consult_date_only__c                                  AS consult_date,
    Original_Consult_Attorney__c                          AS original_consult_attorney,
    Original_Consult_Date_Time__c                         AS original_consult_datetime,
    Original_Consult_Location__c                          AS original_consult_location,
    Reschedule_Reason__c                                  AS reschedule_reason,
    Reschedule_Notes__c                                   AS reschedule_notes,
    Location                                              AS location,
    Google_Meet_Link__c                                   AS google_meet_link,
    Zoom_Link__c                                          AS zoom_link,
    Zoom_Pass_Code_and_Phone__c                           AS zoom_passcode,
    Meeting_Rooms__c                                      AS meeting_room,
    Owner_Role__c                                         AS owner_role,
    Attorney_Name_as_Text__c                              AS attorney_name,
    Assigned_To_PickList__c                               AS assigned_to,
    Client_Mobile_Number__c                               AS client_mobile,
    Company_Name__c                                       AS company_name,
    WhoId                                                 AS who_id,
    WhatId                                                AS what_id,
    NPS_Score__c                                          AS nps_score,
    SAFE_CAST(Review_Score__c AS FLOAT64)                 AS review_score,
    Review_Comments__c                                    AS review_comments,
    Reviewed_Site__c                                      AS reviewed_site,
    State__c                                              AS state,
    Notes__c                                              AS notes,
    CAST(Next_Steps_Value__c AS STRING)                   AS next_steps,
    Text_Message__c                                       AS text_message,
    IsRecurrence                                          AS is_recurring,
    IsAllDayEvent                                         AS is_all_day,
    IsGroupEvent                                          AS is_group_event,
    IsDeleted                                             AS is_deleted,
    IsArchived                                            AS is_archived,
    CreatedById                                           AS created_by_id,
    CreatedDate                                           AS created_date,
    LastModifiedById                                      AS last_modified_by_id,
    LastModifiedDate                                      AS last_modified_date,
    SystemModstamp                                        AS system_modstamp,
    OldOrg_Record_ID__c                                   AS old_org_record_id,
    External_Sync_Id__c                                   AS external_sync_id,
    CURRENT_TIMESTAMP()                                   AS bq_loaded_at,
    'sf_events_completed'                                 AS bq_source_table

  FROM `sterling-lawyers-database.sterling_sf_staging.sf_events_completed`

) AS S
ON T.sf_record_id = S.sf_record_id

-- ── UPDATE: only when source record is strictly newer ────────
WHEN MATCHED AND S.last_modified_date > T.last_modified_date THEN UPDATE SET
  T.source_object             = S.source_object,
  T.account_id                = S.account_id,
  T.owner_id                  = S.owner_id,
  T.record_type_id            = S.record_type_id,
  T.subject                   = S.subject,
  T.description               = S.description,
  T.activity_type             = S.activity_type,
  T.event_subtype             = S.event_subtype,
  T.task_subtype              = S.task_subtype,
  T.disposition               = S.disposition,
  T.status                    = S.status,
  T.priority                  = S.priority,
  T.start_datetime            = S.start_datetime,
  T.end_datetime              = S.end_datetime,
  T.completed_datetime        = S.completed_datetime,
  T.duration_minutes          = S.duration_minutes,
  T.consult_attorney          = S.consult_attorney,
  T.consult_type              = S.consult_type,
  T.consult_location          = S.consult_location,
  T.consult_date              = S.consult_date,
  T.original_consult_attorney = S.original_consult_attorney,
  T.original_consult_datetime = S.original_consult_datetime,
  T.original_consult_location = S.original_consult_location,
  T.reschedule_reason         = S.reschedule_reason,
  T.reschedule_notes          = S.reschedule_notes,
  T.location                  = S.location,
  T.google_meet_link          = S.google_meet_link,
  T.zoom_link                 = S.zoom_link,
  T.zoom_passcode             = S.zoom_passcode,
  T.meeting_room              = S.meeting_room,
  T.owner_role                = S.owner_role,
  T.attorney_name             = S.attorney_name,
  T.assigned_to               = S.assigned_to,
  T.client_mobile             = S.client_mobile,
  T.company_name              = S.company_name,
  T.who_id                    = S.who_id,
  T.what_id                   = S.what_id,
  T.nps_score                 = S.nps_score,
  T.review_score              = S.review_score,
  T.review_comments           = S.review_comments,
  T.reviewed_site             = S.reviewed_site,
  T.state                     = S.state,
  T.notes                     = S.notes,
  T.next_steps                = S.next_steps,
  T.text_message              = S.text_message,
  T.is_recurring              = S.is_recurring,
  T.is_all_day                = S.is_all_day,
  T.is_group_event            = S.is_group_event,
  T.is_deleted                = S.is_deleted,
  T.is_archived               = S.is_archived,
  T.last_modified_by_id       = S.last_modified_by_id,
  T.last_modified_date        = S.last_modified_date,
  T.system_modstamp           = S.system_modstamp,
  T.old_org_record_id         = S.old_org_record_id,
  T.external_sync_id          = S.external_sync_id,
  T.bq_loaded_at              = S.bq_loaded_at,
  T.bq_source_table           = S.bq_source_table

-- ── INSERT: net-new records only ─────────────────────────────
WHEN NOT MATCHED THEN INSERT (
  sf_record_id, source_object, account_id, owner_id, record_type_id,
  subject, description, activity_type, event_subtype, task_subtype,
  disposition, status, priority,
  start_datetime, end_datetime, completed_datetime, duration_minutes,
  consult_attorney, consult_type, consult_location, consult_date,
  original_consult_attorney, original_consult_datetime, original_consult_location,
  reschedule_reason, reschedule_notes, location, google_meet_link,
  zoom_link, zoom_passcode, meeting_room, owner_role, attorney_name,
  assigned_to, client_mobile, company_name, who_id, what_id,
  nps_score, review_score, review_comments, reviewed_site,
  state, notes, next_steps, text_message,
  is_recurring, is_all_day, is_group_event, is_deleted, is_archived,
  created_by_id, created_date, last_modified_by_id, last_modified_date,
  system_modstamp, old_org_record_id, external_sync_id,
  bq_loaded_at, bq_source_table
)
VALUES (
  S.sf_record_id, S.source_object, S.account_id, S.owner_id, S.record_type_id,
  S.subject, S.description, S.activity_type, S.event_subtype, S.task_subtype,
  S.disposition, S.status, S.priority,
  S.start_datetime, S.end_datetime, S.completed_datetime, S.duration_minutes,
  S.consult_attorney, S.consult_type, S.consult_location, S.consult_date,
  S.original_consult_attorney, S.original_consult_datetime, S.original_consult_location,
  S.reschedule_reason, S.reschedule_notes, S.location, S.google_meet_link,
  S.zoom_link, S.zoom_passcode, S.meeting_room, S.owner_role, S.attorney_name,
  S.assigned_to, S.client_mobile, S.company_name, S.who_id, S.what_id,
  S.nps_score, S.review_score, S.review_comments, S.reviewed_site,
  S.state, S.notes, S.next_steps, S.text_message,
  S.is_recurring, S.is_all_day, S.is_group_event, S.is_deleted, S.is_archived,
  S.created_by_id, S.created_date, S.last_modified_by_id, S.last_modified_date,
  S.system_modstamp, S.old_org_record_id, S.external_sync_id,
  S.bq_loaded_at, S.bq_source_table
);