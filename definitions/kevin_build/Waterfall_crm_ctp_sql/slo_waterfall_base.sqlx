CREATE OR REPLACE TABLE
  `rc-datamart-report-082025.genesis_looker_crm_ctp_universal_table.slo_tmp_historical_base` AS

WITH firm AS (
  SELECT 'SterlingLawOffice-1010' AS Firm_Unique_ID,
         'Sterling Lawyers'     AS Firm_Name
),
date_spine AS (
  SELECT d AS metric_date
  FROM UNNEST(GENERATE_DATE_ARRAY(DATE '2017-01-01', CURRENT_DATE())) d
),
src AS (
  SELECT * FROM `focused-sentry-464713-u0.salesforce_slo.slo_alldata_delta`
),

s AS (
  SELECT
    s.*,

    -- UTC -> New York (America/New_York)
    DATE(COALESCE(
      SAFE_CAST(lead_CreatedDate AS TIMESTAMP),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', SAFE_CAST(lead_CreatedDate AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', SAFE_CAST(lead_CreatedDate AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S UTC',  SAFE_CAST(lead_CreatedDate AS STRING))
    ), 'America/New_York') AS lead_created_central_d,

    DATE(COALESCE(
      SAFE_CAST(opportunity_CreatedDate AS TIMESTAMP),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', SAFE_CAST(opportunity_CreatedDate AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', SAFE_CAST(opportunity_CreatedDate AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S UTC',  SAFE_CAST(opportunity_CreatedDate AS STRING))
    ), 'America/New_York') AS opportunity_created_central_d,

    DATE(COALESCE(
      SAFE_CAST(opportunity_Consult_Date_Time__c AS TIMESTAMP),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', SAFE_CAST(opportunity_Consult_Date_Time__c AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', SAFE_CAST(opportunity_Consult_Date_Time__c AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S UTC',  SAFE_CAST(opportunity_Consult_Date_Time__c AS STRING))
    ), 'America/New_York') AS consult_start_central_d,

    DATE(COALESCE(
      SAFE_CAST(consult_CreatedDate AS TIMESTAMP),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', SAFE_CAST(consult_CreatedDate AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', SAFE_CAST(consult_CreatedDate AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S UTC',  SAFE_CAST(consult_CreatedDate AS STRING))
    ), 'America/New_York') AS consult_created_central_d,

    COALESCE(
      SAFE_CAST(lead_Referred_Out_Date__c AS DATE),
      SAFE.PARSE_DATE('%Y-%m-%d', SAFE_CAST(lead_Referred_Out_Date__c AS STRING)),
      SAFE.PARSE_DATE('%m/%d/%Y', SAFE_CAST(lead_Referred_Out_Date__c AS STRING)),
      SAFE.PARSE_DATE('%Y-%m-%d.', SAFE_CAST(lead_Referred_Out_Date__c AS STRING))
    ) AS lead_referred_out_d,

    COALESCE(
      SAFE_CAST(opportunity_Reinstituted_Funded_Date__c AS DATE),
      SAFE.PARSE_DATE('%Y-%m-%d', SAFE_CAST(opportunity_Reinstituted_Funded_Date__c AS STRING)),
      SAFE.PARSE_DATE('%m/%d/%Y', SAFE_CAST(opportunity_Reinstituted_Funded_Date__c AS STRING)),
      SAFE.PARSE_DATE('%Y-%m-%d.', SAFE_CAST(opportunity_Reinstituted_Funded_Date__c AS STRING))
    ) AS funded_reinstituted_d,

    -- Boolean-ish flags
    NOT REGEXP_CONTAINS(COALESCE(SAFE_CAST(lead_LeadSource AS STRING), ''), r'(?i)nps') AS leadsource_not_nps,
    (SAFE_CAST(lead_IsConverted AS BOOL) IS FALSE OR LOWER(TRIM(SAFE_CAST(lead_IsConverted AS STRING))) IN ('false','f','0','no','n')) AS is_converted_falseish,
    (SAFE_CAST(lead_Potential_Lead__c AS BOOL) IS FALSE OR LOWER(TRIM(SAFE_CAST(lead_Potential_Lead__c AS STRING))) IN ('false','f','0','no','n')) AS is_potential_falseish,
    (SAFE_CAST(lead_Web_Lead__c AS BOOL) IS TRUE  OR LOWER(TRIM(SAFE_CAST(lead_Web_Lead__c AS STRING)))  IN ('true','t','1','yes','y')) AS is_web_trueish,

    NOT REGEXP_CONTAINS(COALESCE(SAFE_CAST(quote_Opportunity_Account_Name__c AS STRING), ''), r'(?i)participant') AS oppacct_not_participant,
    NOT REGEXP_CONTAINS(COALESCE(SAFE_CAST(opportunity_Name AS STRING), ''), r'(?i)test')                           AS oppname_not_test,
    SAFE_CAST(quote_Opportunity__c AS STRING) = SAFE_CAST(opportunity_Id AS STRING)                                 AS has_quote_link
  FROM src s
),

-- Calls from the CRM+CTP universal layer
calls_daily AS (
  SELECT
    f.Firm_Unique_ID,
    f.Firm_Name,
    DATE(SAFE_CAST(u.start_datetime AS TIMESTAMP), 'America/New_York') AS metric_date,
    COUNT(u.Call_Tracking_Unique_ID) AS calls_total_day,
    SUM(CASE WHEN SAFE_CAST(u.Answered AS BOOL) THEN 1 ELSE 0 END) AS calls_answered_day
  FROM `rc-datamart-report-082025.genesis_looker_crm_ctp_universal_table.genesis_crm_ctp_universal_table` u
  JOIN firm f
    ON u.Firm_Unique_ID = f.Firm_Unique_ID
   AND u.Firm_Name      = f.Firm_Name
  WHERE u.start_datetime IS NOT NULL
  GROUP BY f.Firm_Unique_ID, f.Firm_Name, metric_date
),

-- Daily facts
leads_total_daily AS (
  SELECT
    lead_created_central_d AS metric_date,
    COUNT(DISTINCT lead_Id) AS leads_cnt
  FROM s
  WHERE lead_created_central_d IS NOT NULL
    AND leadsource_not_nps
    AND is_converted_falseish
    AND is_potential_falseish
    AND COALESCE(TRIM(SAFE_CAST(lead_Id AS STRING)), '') <> ''
  GROUP BY metric_date
),
opportunity_total_daily AS (
  SELECT
    opportunity_created_central_d AS metric_date,
    COUNT(DISTINCT opportunity_Id) AS opp_cnt
  FROM s
  WHERE opportunity_created_central_d IS NOT NULL
    AND oppacct_not_participant
    AND COALESCE(TRIM(SAFE_CAST(opportunity_Id AS STRING)), '') <> ''
  GROUP BY metric_date
),
total_leads_daily AS (
  SELECT
    COALESCE(l.metric_date, o.metric_date) AS metric_date,
    COALESCE(l.leads_cnt, 0) + COALESCE(o.opp_cnt, 0) AS total_leads_day
  FROM leads_total_daily l
  FULL JOIN opportunity_total_daily o
    ON l.metric_date = o.metric_date
),

web_leads_daily AS (
  SELECT
    lead_created_central_d AS metric_date,
    COUNT(DISTINCT lead_Id) AS web_leads_cnt
  FROM s
  WHERE lead_created_central_d IS NOT NULL
    AND leadsource_not_nps
    AND is_converted_falseish
    AND is_potential_falseish
    AND is_web_trueish
  GROUP BY metric_date
),
web_opportunity_daily AS (
  SELECT
    opportunity_created_central_d AS metric_date,
    COUNT(DISTINCT opportunity_Id) AS web_opp_cnt
  FROM s
  WHERE opportunity_created_central_d IS NOT NULL
    AND oppacct_not_participant
    AND is_web_trueish
  GROUP BY metric_date
),
web_total_daily AS (
  SELECT
    COALESCE(l.metric_date, o.metric_date) AS metric_date,
    COALESCE(l.web_leads_cnt, 0) + COALESCE(o.web_opp_cnt, 0) AS web_leads_day
  FROM web_leads_daily l
  FULL JOIN web_opportunity_daily o
    ON l.metric_date = o.metric_date
),

qpc_f1_daily AS (
  SELECT
    lead_created_central_d AS metric_date,
    COUNT(DISTINCT lead_Id) AS cnt
  FROM s
  WHERE lead_created_central_d IS NOT NULL
    AND leadsource_not_nps
    AND is_converted_falseish
    AND is_potential_falseish
  GROUP BY metric_date
),
qpc_f2_daily AS (
  SELECT
    lead_created_central_d AS metric_date,
    COUNT(DISTINCT lead_Id) AS cnt
  FROM s
  WHERE lead_referred_out_d IS NOT NULL
    AND leadsource_not_nps
    AND is_converted_falseish
    AND is_potential_falseish
  GROUP BY metric_date
),
qpc_f3_daily AS (
  SELECT
    opportunity_created_central_d AS metric_date,
    COUNT(DISTINCT opportunity_Id) AS cnt
  FROM s
  WHERE opportunity_created_central_d IS NOT NULL
    AND oppacct_not_participant
  GROUP BY metric_date
),
qpc_daily AS (
  SELECT
    d.metric_date,
    (COALESCE(f1.cnt, 0) - COALESCE(f2.cnt, 0)) + COALESCE(f3.cnt, 0) AS qpc_day
  FROM date_spine d
  LEFT JOIN qpc_f1_daily f1 ON f1.metric_date = d.metric_date
  LEFT JOIN qpc_f2_daily f2 ON f2.metric_date = d.metric_date
  LEFT JOIN qpc_f3_daily f3 ON f3.metric_date = d.metric_date
),

consults_sched_daily AS (
  SELECT
    consult_start_central_d AS metric_date,
    COUNT(DISTINCT opportunity_Id) AS consults_scheduled_day
  FROM s
  WHERE consult_start_central_d IS NOT NULL
    AND oppacct_not_participant
  GROUP BY metric_date
),

consults_comp_daily AS (
  SELECT
    consult_created_central_d AS metric_date,
    COUNT(DISTINCT opportunity_Id) AS consults_completed_day
  FROM s
  WHERE consult_created_central_d IS NOT NULL
    AND LOWER(TRIM(SAFE_CAST(consult_Consult_Status__c AS STRING))) IN (
      'signed in person - paid',
      'signed in person - unpaid',
      'consult completed',
      'complete'
    )
  GROUP BY metric_date
),

funded_daily AS (
  SELECT
    funded_reinstituted_d AS metric_date,
    COUNT(DISTINCT opportunity_Id) AS funded_agreements_day
  FROM s
  WHERE funded_reinstituted_d IS NOT NULL
  GROUP BY metric_date
),

quotes_daily AS (
  SELECT
    consult_start_central_d AS metric_date,
    COUNT(DISTINCT opportunity_Id) AS quotes_day
  FROM s
  WHERE consult_start_central_d IS NOT NULL
    AND oppacct_not_participant
    AND oppname_not_test
    AND has_quote_link
  GROUP BY metric_date
),

dense AS (
  SELECT
    f.Firm_Unique_ID,
    f.Firm_Name,
    d.metric_date,
    COALESCE(c.calls_total_day, 0)         AS calls_total_day,
    COALESCE(c.calls_answered_day, 0)      AS calls_answered_day,
    COALESCE(t.total_leads_day, 0)         AS total_leads_day,
    COALESCE(w.web_leads_day, 0)           AS web_leads_day,
    COALESCE(q.qpc_day, 0)                 AS qpc_day,
    COALESCE(cs.consults_scheduled_day, 0) AS consults_scheduled_day,
    COALESCE(cc.consults_completed_day, 0) AS consults_completed_day,
    COALESCE(qu.quotes_day, 0)             AS quotes_day,
    COALESCE(fu.funded_agreements_day, 0)  AS funded_agreements_day
  FROM firm f
  CROSS JOIN date_spine d
  LEFT JOIN calls_daily          c  ON c.metric_date = d.metric_date AND c.Firm_Unique_ID = f.Firm_Unique_ID AND c.Firm_Name = f.Firm_Name
  LEFT JOIN total_leads_daily    t  ON t.metric_date = d.metric_date
  LEFT JOIN web_total_daily      w  ON w.metric_date = d.metric_date
  LEFT JOIN qpc_daily            q  ON q.metric_date = d.metric_date
  LEFT JOIN consults_sched_daily cs ON cs.metric_date = d.metric_date
  LEFT JOIN consults_comp_daily  cc ON cc.metric_date = d.metric_date
  LEFT JOIN quotes_daily         qu ON qu.metric_date = d.metric_date
  LEFT JOIN funded_daily         fu ON fu.metric_date = d.metric_date
),

roll AS (
  SELECT
    *,
    -- Calls windows
    SUM(calls_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS calls_w7,
    SUM(calls_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS calls_w28,
    SUM(calls_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS calls_w90,
    SUM(calls_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS calls_w180,
    SUM(calls_total_day)    OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS calls_w365,

    -- Answered windows
    SUM(calls_answered_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS ans_w7,
    SUM(calls_answered_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS ans_w28,
    SUM(calls_answered_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS ans_w90,
    SUM(calls_answered_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS ans_w180,
    SUM(calls_answered_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS ans_w365,

    -- Existing windows
    SUM(total_leads_day)        OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS leads_w7,
    SUM(total_leads_day)        OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS leads_w28,
    SUM(total_leads_day)        OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS leads_w90,
    SUM(total_leads_day)        OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS leads_w180,
    SUM(total_leads_day)        OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS leads_w365,

    SUM(web_leads_day)          OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS web_w7,
    SUM(web_leads_day)          OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS web_w28,
    SUM(web_leads_day)          OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS web_w90,
    SUM(web_leads_day)          OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS web_w180,
    SUM(web_leads_day)          OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS web_w365,

    SUM(qpc_day)                OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS qpc_w7,
    SUM(qpc_day)                OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS qpc_w28,
    SUM(qpc_day)                OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS qpc_w90,
    SUM(qpc_day)                OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS qpc_w180,
    SUM(qpc_day)                OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS qpc_w365,

    SUM(consults_scheduled_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS cs_w7,
    SUM(consults_scheduled_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS cs_w28,
    SUM(consults_scheduled_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS cs_w90,
    SUM(consults_scheduled_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS cs_w180,
    SUM(consults_scheduled_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS cs_w365,

    SUM(consults_completed_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS cc_w7,
    SUM(consults_completed_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS cc_w28,
    SUM(consults_completed_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS cc_w90,
    SUM(consults_completed_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS cc_w180,
    SUM(consults_completed_day) OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS cc_w365,

    SUM(quotes_day)             OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS qts_w7,
    SUM(quotes_day)             OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS qts_w28,
    SUM(quotes_day)             OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS qts_w90,
    SUM(quotes_day)             OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS qts_w180,
    SUM(quotes_day)             OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS qts_w365,

    SUM(funded_agreements_day)  OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 7   PRECEDING AND 1 PRECEDING) AS fa_w7,
    SUM(funded_agreements_day)  OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 28  PRECEDING AND 1 PRECEDING) AS fa_w28,
    SUM(funded_agreements_day)  OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 90  PRECEDING AND 1 PRECEDING) AS fa_w90,
    SUM(funded_agreements_day)  OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 180 PRECEDING AND 1 PRECEDING) AS fa_w180,
    SUM(funded_agreements_day)  OVER (PARTITION BY Firm_Unique_ID, Firm_Name ORDER BY metric_date ROWS BETWEEN 365 PRECEDING AND 1 PRECEDING) AS fa_w365
  FROM dense
)

SELECT
  r.metric_date,
  m.date_window,
  r.Firm_Unique_ID,
  r.Firm_Name,
  SAFE_CAST(NULL AS STRING) AS Marketing_Channel,
  m.metric_name,
  ROUND(m.metric_value, 1) AS metric_value         -- 🔹 rounded to 1 decimal place
FROM roll r
CROSS JOIN UNNEST([
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Calls','last_7_days'   , SAFE_DIVIDE(calls_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Calls','last_28_days'  , SAFE_DIVIDE(calls_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Calls','last_3_months' , SAFE_DIVIDE(calls_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Calls','last_6_months' , SAFE_DIVIDE(calls_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Calls','last_12_months', SAFE_DIVIDE(calls_w365,260)),

  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Answered Calls','last_7_days'   , SAFE_DIVIDE(ans_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Answered Calls','last_28_days'  , SAFE_DIVIDE(ans_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Answered Calls','last_3_months' , SAFE_DIVIDE(ans_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Answered Calls','last_6_months' , SAFE_DIVIDE(ans_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Answered Calls','last_12_months', SAFE_DIVIDE(ans_w365,260)),

  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Leads','last_7_days'   , SAFE_DIVIDE(leads_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Leads','last_28_days'  , SAFE_DIVIDE(leads_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Leads','last_3_months' , SAFE_DIVIDE(leads_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Leads','last_6_months' , SAFE_DIVIDE(leads_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Total Leads','last_12_months', SAFE_DIVIDE(leads_w365,260)),

  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Inbound Leads','last_7_days'   , SAFE_DIVIDE(leads_w7   - web_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Inbound Leads','last_28_days'  , SAFE_DIVIDE(leads_w28  - web_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Inbound Leads','last_3_months' , SAFE_DIVIDE(leads_w90  - web_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Inbound Leads','last_6_months' , SAFE_DIVIDE(leads_w180 - web_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Inbound Leads','last_12_months', SAFE_DIVIDE(leads_w365 - web_w365,260)),

  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Web Leads','last_7_days'   , SAFE_DIVIDE(web_w7,    5)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Web Leads','last_28_days'  , SAFE_DIVIDE(web_w28,  20)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Web Leads','last_3_months' , SAFE_DIVIDE(web_w90,  65)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Web Leads','last_6_months' , SAFE_DIVIDE(web_w180,130)),
  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('Web Leads','last_12_months', SAFE_DIVIDE(web_w365,260)),

  STRUCT<metric_name STRING, date_window STRING, metric_value FLOAT64>('QPCs','last_7_days'   , SAFE_DIVIDE(qpc_w7,    5)),
