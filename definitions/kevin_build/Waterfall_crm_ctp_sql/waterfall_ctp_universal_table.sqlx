CREATE OR REPLACE TABLE `focused-sentry-464713-u0.ctp_universal_tables.genesis_ctp_universal_table` AS 
-- 1) GENESIS
WITH base_genesis AS (
  SELECT
    'Genesis-glg1000' AS firm_unique_id,
    'Genesis' AS firm_name,
    CAST(answered AS BOOL) AS answered,
    direction,
    SAFE_CAST(duration AS INT64) AS recording_duration,
    id AS call_tracking_unique_id,
    SAFE_CAST(recording_duration AS INT64) AS call_recording_duration,
    COALESCE(
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(start_time AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(start_time AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S%Ez',  TRIM(CAST(start_time AS STRING))),
      CAST(start_time AS TIMESTAMP)
    ) AS start_datetime
  FROM `focused-sentry-464713-u0.callrail_genesis.callrail_alldata_delta`
  WHERE REGEXP_CONTAINS(COALESCE(direction, ''), r'(?i)^\s*inbound\s*$')
),
ranked_genesis AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY call_tracking_unique_id ORDER BY start_datetime DESC) AS row_num
  FROM base_genesis
),

-- 2) VDL
base_vdl AS (
  SELECT
    'VDL-vdl1001' AS firm_unique_id,
    'Vasquez de Lara' AS firm_name,
    CAST(answered AS BOOL) AS answered,
    direction,
    SAFE_CAST(duration AS INT64) AS recording_duration,
    id AS call_tracking_unique_id,
    SAFE_CAST(recording_duration AS INT64) AS call_recording_duration,
    COALESCE(
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(start_time AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(start_time AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S%Ez',  TRIM(CAST(start_time AS STRING))),
      CAST(start_time AS TIMESTAMP)
    ) AS start_datetime
  FROM `focused-sentry-464713-u0.callrail_vdl.callrail_historical_delta`
  WHERE REGEXP_CONTAINS(COALESCE(direction, ''), r'(?i)^\s*inbound\s*$')
),
ranked_vdl AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY call_tracking_unique_id ORDER BY start_datetime DESC) AS row_num
  FROM base_vdl
),

-- 3) SMB
base_smb AS (
  SELECT
    'SMB-smb1002' AS firm_unique_id,
    'Scott M Brown' AS firm_name,
    CAST(answered AS BOOL) AS answered,
    direction,
    SAFE_CAST(duration AS INT64) AS recording_duration,
    id AS call_tracking_unique_id,
    SAFE_CAST(recording_duration AS INT64) AS call_recording_duration,
    COALESCE(
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(start_time AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(start_time AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S%Ez',  TRIM(CAST(start_time AS STRING))),
      CAST(start_time AS TIMESTAMP)
    ) AS start_datetime
  FROM `focused-sentry-464713-u0.callrail_smb.callrail_initial_alldata_staging`
  WHERE REGEXP_CONTAINS(COALESCE(direction, ''), r'(?i)^\s*inbound\s*$')
),
ranked_smb AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY call_tracking_unique_id ORDER BY start_datetime DESC) AS row_num
  FROM base_smb
),

-- 4) ROSENBLUM (CallTracking)
base_rosenblum AS (
  SELECT
    'Rosenblum-ral1004'       AS firm_unique_id,
    'Rosenblum Allen Law'     AS firm_name,
    CAST(LOWER(call_status) = 'answered' AS BOOL) AS answered,
    direction,
    CAST(NULL AS INT64)       AS recording_duration,
    sid                        AS call_tracking_unique_id,
    CAST(NULL AS INT64)       AS call_recording_duration,
    COALESCE(
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %I:%M %p %Ez', TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %I:%M %p %z',  TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %I:%M:%S %p %Ez', TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %I:%M:%S %p %z',  TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez',   TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez',   TRIM(CAST(called_at AS STRING))),
      CAST(called_at AS TIMESTAMP)
    ) AS start_datetime
  FROM `focused-sentry-464713-u0.calltracking_rosenblum.ctp_initialdata_delta`
  WHERE REGEXP_CONTAINS(COALESCE(direction, ''), r'(?i)^\s*inbound\s*$')
),
ranked_rosenblum AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY call_tracking_unique_id ORDER BY start_datetime DESC) AS row_num
  FROM base_rosenblum
),

-- 5) MEYERPINK
base_meyerpink AS (
