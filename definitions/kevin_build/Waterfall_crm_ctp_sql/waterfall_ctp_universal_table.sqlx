    COALESCE(
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(start_time AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(start_time AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S%Ez',  TRIM(CAST(start_time AS STRING))),
      CAST(start_time AS TIMESTAMP)
    ) AS start_datetime,
    source AS source,
    CAST(NULL AS STRING) AS practice_area,
    CAST(NULL AS STRING) AS marketing_channel,
    CAST(NULL AS STRING) AS utm_campaign,
    CAST(NULL AS STRING) AS utm_content,
    CAST(NULL AS STRING) AS utm_ict_reference_number,
    CAST(NULL AS STRING) AS utm_medium,
    CAST(NULL AS INT64)  AS utm_pageview_count,
    CAST(NULL AS INT64)  AS utm_session_count,
    CAST(NULL AS STRING) AS utm_source,
    CAST(NULL AS STRING) AS utm_term,
    CAST(NULL AS STRING) AS ga_client_id,
    CAST(NULL AS STRING) AS ga_user_id,
    CAST(NULL AS STRING) AS gclid,
    CAST(NULL AS STRING) AS google_ads
  FROM `focused-sentry-464713-u0.callrail_theramagelawgroup.callrail_alldata_delta`
  WHERE REGEXP_CONTAINS(COALESCE(direction, ''), r'(?i)^\s*inbound\s*$')
),
ranked_ramage AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY call_tracking_unique_id ORDER BY start_datetime DESC) AS row_num
  FROM base_ramage
),

-- 13) CHISHOLM LAW FIRM
base_chisholm AS (
  SELECT
    'chisholmlawfirm-1012' AS firm_unique_id,
    'Chisholm Law Firm'    AS firm_name,
    CAST(answered AS BOOL) AS answered,
    direction,
    SAFE_CAST(recording_duration AS INT64) AS recording_duration,
    id AS call_tracking_unique_id,
    SAFE_CAST(recording_duration AS INT64) AS call_recording_duration,
    COALESCE(
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(start_time AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(start_time AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S%Ez',  TRIM(CAST(start_time AS STRING))),
      CAST(start_time AS TIMESTAMP)
    ) AS start_datetime,
    CAST(NULL AS STRING) AS source,
    CAST(NULL AS STRING) AS practice_area,
    CAST(NULL AS STRING) AS marketing_channel,
    CAST(NULL AS STRING) AS utm_campaign,
    CAST(NULL AS STRING) AS utm_content,
    CAST(NULL AS STRING) AS utm_ict_reference_number,
    CAST(NULL AS STRING) AS utm_medium,
    CAST(NULL AS INT64)  AS utm_pageview_count,
    CAST(NULL AS INT64)  AS utm_session_count,
    CAST(NULL AS STRING) AS utm_source,
    CAST(NULL AS STRING) AS utm_term,
    CAST(NULL AS STRING) AS ga_client_id,
    CAST(NULL AS STRING) AS ga_user_id,
    CAST(NULL AS STRING) AS gclid,
    CAST(NULL AS STRING) AS google_ads
  FROM `focused-sentry-464713-u0.callrail_chisholm.callrail_alldata_delta`
  WHERE REGEXP_CONTAINS(COALESCE(direction, ''), r'(?i)^\s*inbound\s*$')
),
ranked_chisholm AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY call_tracking_unique_id ORDER BY start_datetime DESC) AS row_num
  FROM base_chisholm
),

-- 14) KALISH AND JAGGARS (CallTracking)
base_kalishjaggars AS (
  SELECT
    'kalishandjaggars-1013'                     AS firm_unique_id,
    'Kalish And Jaggars'                        AS firm_name,
    CAST(LOWER(call_status) = 'answered' AS BOOL) AS answered,
    direction,
    SAFE_CAST(duration AS INT64)                AS recording_duration,
    sid                                         AS call_tracking_unique_id,
    CAST(NULL AS INT64)                         AS call_recording_duration,
    COALESCE(
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %I:%M %p %Ez', TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %I:%M %p %z',  TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %I:%M:%S %p %Ez', TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %I:%M:%S %p %z',  TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(called_at AS STRING))),
      SAFE.TIMESTAMP(called_at),
      SAFE.TIMESTAMP_SECONDS(SAFE_CAST(unix_time AS INT64))
    ) AS start_datetime,
    CAST(NULL AS STRING) AS source,              -- mapping sheet: NULL
    CAST(NULL AS STRING) AS practice_area,
    CAST(NULL AS STRING) AS marketing_channel,
    CAST(NULL AS STRING) AS utm_campaign,
    CAST(NULL AS STRING) AS utm_content,
    CAST(NULL AS STRING) AS utm_ict_reference_number,
    CAST(NULL AS STRING) AS utm_medium,
    CAST(NULL AS INT64)  AS utm_pageview_count,
    CAST(NULL AS INT64)  AS utm_session_count,
    CAST(NULL AS STRING) AS utm_source,
    CAST(NULL AS STRING) AS utm_term,
    CAST(NULL AS STRING) AS ga_client_id,
    CAST(NULL AS STRING) AS ga_user_id,
    ga.gclid             AS gclid,
    CAST(NULL AS STRING) AS google_ads
  FROM `focused-sentry-464713-u0.calltracking_kalishandjaggars.ctp_initialdata_delta`
  WHERE REGEXP_CONTAINS(COALESCE(direction, ''), r'(?i)^\s*inbound\s*$')
),
ranked_kalishjaggars AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY call_tracking_unique_id ORDER BY start_datetime DESC) AS row_num
  FROM base_kalishjaggars
),

-- 15) FANASH FAMILY LAW (CallRail)
base_fanash AS (
  SELECT
    'fanashfamilylaw-1013' AS firm_unique_id,
    'Fanash Family Law'   AS firm_name,
    CAST(answered AS BOOL) AS answered,
    direction,
    SAFE_CAST(duration AS INT64) AS recording_duration,
    id AS call_tracking_unique_id,
    SAFE_CAST(recording_duration AS INT64) AS call_recording_duration,
    COALESCE(
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(start_time AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(start_time AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S%Ez',  TRIM(CAST(start_time AS STRING))),
      CAST(start_time AS TIMESTAMP)
    ) AS start_datetime,
    CAST(NULL AS STRING) AS source,
    CAST(NULL AS STRING) AS practice_area,
    CAST(NULL AS STRING) AS marketing_channel,
    CAST(NULL AS STRING) AS utm_campaign,
    CAST(NULL AS STRING) AS utm_content,
    CAST(NULL AS STRING) AS utm_ict_reference_number,
    CAST(NULL AS STRING) AS utm_medium,
    CAST(NULL AS INT64)  AS utm_pageview_count,
    CAST(NULL AS INT64)  AS utm_session_count,
    CAST(NULL AS STRING) AS utm_source,
    CAST(NULL AS STRING) AS utm_term,
    CAST(NULL AS STRING) AS ga_client_id,
    CAST(NULL AS STRING) AS ga_user_id,
     CAST(NULL AS STRING) AS gclid,
    CAST(NULL AS STRING) AS google_ads
  FROM `focused-sentry-464713-u0.callrail_fanashfamilylaw.callrail_alldata_delta`
  WHERE REGEXP_CONTAINS(COALESCE(direction, ''), r'(?i)^\s*inbound\s*$')
),
ranked_fanash AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY call_tracking_unique_id ORDER BY start_datetime DESC) AS row_num
  FROM base_fanash
)

, unioned AS (
  SELECT
    firm_unique_id            AS firm_unique_id,
    firm_name                 AS firm_name,
    answered                  AS answered,
    direction                 AS direction,
    recording_duration        AS recording_duration,
    call_tracking_unique_id   AS call_tracking_unique_id,
    call_recording_duration   AS call_recording_duration,
    start_datetime            AS start_datetime,
    source                    AS source,
    practice_area             AS practice_area,
    marketing_channel         AS marketing_channel,
    utm_campaign              AS utm_campaign,
    utm_content               AS utm_content,
    utm_ict_reference_number  AS utm_ict_reference_number,
    utm_medium                AS utm_medium,
    utm_pageview_count        AS utm_pageview_count,
    utm_session_count         AS utm_session_count,
    utm_source                AS utm_source,
    utm_term                  AS utm_term,
    ga_client_id              AS ga_client_id,
    ga_user_id                AS ga_user_id,
    gclid                     AS gclid,
    google_ads                AS google_ads
  FROM ranked_genesis WHERE row_num = 1

  UNION ALL
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_vdl WHERE row_num = 1

  UNION ALL
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_smb WHERE row_num = 1

  UNION ALL
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_rosenblum WHERE row_num = 1

  UNION ALL
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_meyerpink WHERE row_num = 1

  UNION ALL
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_auritmediation WHERE row_num = 1

  UNION ALL
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_summit WHERE row_num = 1

  UNION ALL
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_brucelaw WHERE row_num = 1

  UNION ALL
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_drakelaw WHERE row_num = 1

  UNION ALL
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_haffner WHERE row_num = 1

  UNION ALL
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_slo WHERE row_num = 1

  UNION ALL
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_ramage WHERE row_num = 1

  UNION ALL
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_chisholm WHERE row_num = 1

  UNION ALL
  -- KALISH AND JAGGARS
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_kalishjaggars WHERE row_num = 1

  UNION ALL
  -- FANASH FAMILY LAW
  SELECT
    firm_unique_id, firm_name, answered, direction, recording_duration,
    call_tracking_unique_id, call_recording_duration, start_datetime,
    source, practice_area, marketing_channel, utm_campaign, utm_content,
    utm_ict_reference_number, utm_medium, utm_pageview_count, utm_session_count,
    utm_source, utm_term, ga_client_id, ga_user_id, gclid, google_ads
  FROM ranked_fanash WHERE row_num = 1
)

SELECT
  firm_unique_id,
  firm_name,
  answered,
  direction,
  IFNULL(recording_duration, 0) AS recording_duration,
  call_tracking_unique_id,
  IFNULL(call_recording_duration, 0) AS call_recording_duration,
  start_datetime,
  source,
  practice_area,
  marketing_channel,
  utm_campaign,
  utm_content,
  utm_ict_reference_number,
  utm_medium,
  utm_pageview_count,
  utm_session_count,
  utm_source,
  utm_term,
  ga_client_id,
  ga_user_id,
  gclid,
  google_ads
FROM unioned;
