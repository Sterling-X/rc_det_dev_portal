  FROM base_chisholm
),

base_kalishjaggars AS (
  SELECT
    'kalishandjaggars-1013' AS firm_unique_id,
    'Kalish And Jaggars' AS firm_name,
    CAST(LOWER(call_status) = 'answered' AS BOOL) AS answered,
    direction,
    SAFE_CAST(duration AS INT64) AS recording_duration,
    sid AS call_tracking_unique_id,
    CAST(NULL AS INT64) AS call_recording_duration,
    COALESCE(
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %I:%M %p %Ez', TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %I:%M %p %z',  TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %I:%M:%S %p %Ez', TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %I:%M:%S %p %z',  TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(called_at AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(called_at AS STRING))),
      SAFE.TIMESTAMP(called_at),
      SAFE.TIMESTAMP_SECONDS(SAFE_CAST(unix_time AS INT64))
    ) AS start_datetime,
    CAST(NULL AS STRING) AS source,
    CAST(NULL AS STRING) AS practice_area,
    CAST(NULL AS STRING) AS marketing_channel,
    CAST(NULL AS STRING) AS utm_campaign,
    CAST(NULL AS STRING) AS utm_content,
