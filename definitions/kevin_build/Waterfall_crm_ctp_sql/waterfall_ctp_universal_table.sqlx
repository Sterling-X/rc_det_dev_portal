marketing_dir AS (
  SELECT
    Firm_Unique_ID,
    CASE
      WHEN ctp_number IS NULL THEN NULL
      ELSE
        CASE
          WHEN LENGTH(REGEXP_REPLACE(CAST(ctp_number AS STRING), r'\D', '')) > 10
            THEN RIGHT(REGEXP_REPLACE(CAST(ctp_number AS STRING), r'\D', ''), 10)
          ELSE REGEXP_REPLACE(CAST(ctp_number AS STRING), r'\D', '')
        END
    END AS normalized_ctp_number,
    ctp_number,
    ctp_label,
    ctp_source,
    forward_calls_to,
    channel
  FROM `rc-datamart-report-082025.waterfall_marketing_channel.universal_firm_marketing_channel`
),

unioned_with_numbers AS (
  SELECT
    u.*,
    COALESCE(
      cr_vdl.formatted_tracking_phone_number,
      cr_smb.formatted_tracking_phone_number,
      cr_meyerpink.formatted_tracking_phone_number,
      cr_aurit.formatted_tracking_phone_number,
      cr_summit.formatted_tracking_phone_number,
      cr_bruce.formatted_tracking_phone_number,
      cr_drake.formatted_tracking_phone_number,
      cr_ramage.formatted_tracking_phone_number,
      cr_chisholm.formatted_tracking_phone_number,
      cr_fanash.formatted_tracking_phone_number,
      cr_arizona.formatted_tracking_phone_number,
      cr_johnson.formatted_tracking_phone_number,
      cr_cutrer.formatted_tracking_phone_number,
      cr_lancaster.formatted_tracking_phone_number,
      wv_ireland.dialed_number,
      ct_rosenblum.tracking_number_bare,
      ct_haffner.tracking_number_bare,
      ct_slo.tracking_number_bare,
      ct_kalish.tracking_number_bare
    ) AS tracking_number_source
  FROM unioned u
  LEFT JOIN `focused-sentry-464713-u0.callrail_vdl.callrail_alldata_delta` AS cr_vdl
    ON u.firm_unique_id = 'VDL-vdl1001' AND cr_vdl.id = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.callrail_smb.callrail_alldata_delta` AS cr_smb
    ON u.firm_unique_id = 'SMB-smb1002' AND cr_smb.id = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.calltracking_rosenblum.ctp_initialdata_delta` AS ct_rosenblum
    ON u.firm_unique_id = 'Rosenblum-ral1004' AND ct_rosenblum.sid = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.callrail_meyerpink.callrail_alldata_delta` AS cr_meyerpink
    ON u.firm_unique_id = 'meyerpinklaw-mpl1005' AND cr_meyerpink.id = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.callrail_auritmediation.callrail_alldata_delta` AS cr_aurit
    ON u.firm_unique_id = 'auritmediation-am1007' AND cr_aurit.id = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.callrail_summit.callrail_alldata_delta` AS cr_summit
    ON u.firm_unique_id = 'sumitfamilylawinc-sfl1006' AND cr_summit.id = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.callrail_brucelaw.callrail_alldata_delta` AS cr_bruce
    ON u.firm_unique_id = 'Brucelaw-blg-1003' AND cr_bruce.id = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.callrail_drakelaw.callrail_alldata_delta` AS cr_drake
    ON u.firm_unique_id = 'drakelaw-dl1008' AND cr_drake.id = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.calltracking_haffner.ctp_initialdata_delta` AS ct_haffner
    ON u.firm_unique_id = 'haffner-haffner1009' AND ct_haffner.sid = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.calltracking_slo.ctp_initialdata_delta` AS ct_slo
    ON u.firm_unique_id = 'SterlingLawOffice-1010' AND ct_slo.sid = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.callrail_theramagelawgroup.callrail_alldata_delta` AS cr_ramage
    ON u.firm_unique_id = 'theramagelawgroup-1011' AND cr_ramage.id = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.callrail_chisholm.callrail_alldata_delta` AS cr_chisholm
    ON u.firm_unique_id = 'chisholmlawfirm-1012' AND cr_chisholm.id = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.calltracking_kalishandjaggars.ctp_initialdata_delta` AS ct_kalish
    ON u.firm_unique_id = 'kalishandjaggars-1013' AND ct_kalish.sid = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.callrail_fanashfamilylaw.callrail_alldata_delta` AS cr_fanash
    ON u.firm_unique_id = 'fanashfamilylaw-1013' AND cr_fanash.id = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.callrail_arizonafamilylaw.callrail_alldata_delta` AS cr_arizona
    ON u.firm_unique_id = 'arizonafamilylaw-1015' AND cr_arizona.id = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.callrail_johnsonlawgroup.callrail_initialdata_delta` AS cr_johnson
    ON u.firm_unique_id = 'johnsonlawgroup-1016' AND cr_johnson.id = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.callrail_cutrer.callrail_alldata_delta` AS cr_cutrer
    ON u.firm_unique_id = 'cutrerlaw-1017' AND cr_cutrer.id_b80bb774 = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.callrail_lancaster.callrail_alldata_delta` AS cr_lancaster
    ON u.firm_unique_id = 'lancaster-1023' AND cr_lancaster.id = u.call_tracking_unique_id
  LEFT JOIN `focused-sentry-464713-u0.wave_ireland.wave_alldata_delta` AS wv_ireland
    ON u.firm_unique_id = 'irelandandassociates-1021' AND wv_ireland.call_id = u.call_tracking_unique_id
),

unioned_normalized AS (
  SELECT
    uwn.*,
    CASE
      WHEN tracking_number_source IS NULL THEN NULL
      ELSE
        CASE
          WHEN LENGTH(REGEXP_REPLACE(CAST(tracking_number_source AS STRING), r'\D', '')) > 10
            THEN RIGHT(REGEXP_REPLACE(CAST(tracking_number_source AS STRING), r'\D', ''), 10)
          ELSE REGEXP_REPLACE(CAST(tracking_number_source AS STRING), r'\D', '')
        END
    END AS normalized_ctp_number
  FROM unioned_with_numbers uwn
)

SELECT
  u.firm_unique_id,
  u.firm_name,
  u.answered,
  u.direction,
  IFNULL(u.recording_duration, 0) AS recording_duration,
  u.call_tracking_unique_id,
  IFNULL(u.call_recording_duration, 0) AS call_recording_duration,
  u.start_datetime,
  u.source,
  u.practice_area,
  md.channel AS marketing_channel,
  u.utm_campaign,
  u.utm_content,
  u.utm_ict_reference_number,
  u.utm_medium,
  u.utm_pageview_count,
  u.utm_session_count,
  u.utm_source,
  u.utm_term,
  u.ga_client_id,
  u.ga_user_id,
  u.gclid,
  u.google_ads,
  md.ctp_number,
  md.ctp_label,
  md.ctp_source,
  md.forward_calls_to,
  u.tracking_number_source
FROM unioned_normalized u
LEFT JOIN marketing_dir md
  ON md.Firm_Unique_ID = u.firm_unique_id
 AND md.normalized_ctp_number = u.normalized_ctp_number