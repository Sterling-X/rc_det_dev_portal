    CAST(NULL AS STRING) AS ga_client_id,
    CAST(NULL AS STRING) AS ga_user_id,
    ga.gclid AS gclid,
    CAST(NULL AS STRING) AS google_ads
  FROM `focused-sentry-464713-u0.calltracking_kalishandjaggars.ctp_initialdata_delta`
  WHERE REGEXP_CONTAINS(COALESCE(direction, ''), r'(?i)^\s*inbound\s*$')
