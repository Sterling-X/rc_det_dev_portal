BEGIN

  DECLARE project_id STRING DEFAULT 'focused-sentry-464713-u0';
  DECLARE dataset_id STRING DEFAULT 'salesforce_slo';

  DECLARE tgt         STRING DEFAULT CONCAT('`', project_id, '.', dataset_id, '.slo_alldata_delta`');
  DECLARE lead_tbl    STRING DEFAULT CONCAT('`', project_id, '.', dataset_id, '.Lead`');
  DECLARE opp_tbl     STRING DEFAULT CONCAT('`', project_id, '.', dataset_id, '.Opportunity`');
  DECLARE quote_tbl   STRING DEFAULT CONCAT('`', project_id, '.', dataset_id, '.Quote__c`');
  DECLARE consult_tbl STRING DEFAULT CONCAT('`', project_id, '.', dataset_id, '.Consult__c`');

  DECLARE desc_text STRING DEFAULT
    'Flattened Lead↔Opportunity (ConvertedOpportunityId = Opportunity.Id) + latest Quote__c + latest Consult__c by Opportunity__c; includes all Leads and unmatched Opportunities';

  DECLARE lead_cols    STRING;
  DECLARE opp_cols     STRING;
  DECLARE quote_cols   STRING;
  DECLARE consult_cols STRING;
  DECLARE sql          STRING;

  -- dynamic select lists (lead_*, opportunity_*, quote_*, consult_*)
  SET lead_cols = (
    SELECT STRING_AGG(
             FORMAT('L.%s AS lead_%s', FORMAT('`%s`', column_name), column_name),
             ',\n  ' ORDER BY ordinal_position
           )
    FROM `focused-sentry-464713-u0.salesforce_slo.INFORMATION_SCHEMA.COLUMNS`
    WHERE table_name = 'Lead'
  );

  SET opp_cols = (
    SELECT STRING_AGG(
             FORMAT('O.%s AS opportunity_%s', FORMAT('`%s`', column_name), column_name),
             ',\n  ' ORDER BY ordinal_position
           )
    FROM `focused-sentry-464713-u0.salesforce_slo.INFORMATION_SCHEMA.COLUMNS`
    WHERE table_name = 'Opportunity'
  );

  SET quote_cols = (
    SELECT STRING_AGG(
             FORMAT('Q.%s AS quote_%s', FORMAT('`%s`', column_name), column_name),
             ',\n  ' ORDER BY ordinal_position
           )
    FROM `focused-sentry-464713-u0.salesforce_slo.INFORMATION_SCHEMA.COLUMNS`
    WHERE table_name = 'Quote__c'
  );

  SET consult_cols = (
    SELECT STRING_AGG(
             FORMAT('C.%s AS consult_%s', FORMAT('`%s`', column_name), column_name),
             ',\n  ' ORDER BY ordinal_position
           )
    FROM `focused-sentry-464713-u0.salesforce_slo.INFORMATION_SCHEMA.COLUMNS`
    WHERE table_name = 'Consult__c'
  );

  -- build
  SET sql = CONCAT(
    'CREATE OR REPLACE TABLE ', tgt, '\n',
    'PARTITION BY DATE(loaded_at_utc)\n',
    'CLUSTER BY join_key_18\n',
    'AS\n',
    'WITH l_dedup AS (\n',
    '  SELECT * FROM ', lead_tbl, '\n',
    '  QUALIFY ROW_NUMBER() OVER (PARTITION BY Id ORDER BY SystemModstamp DESC) = 1\n',
    '),\n',
    'o_dedup AS (\n',
    '  SELECT * FROM ', opp_tbl, '\n',
    '  QUALIFY ROW_NUMBER() OVER (PARTITION BY Id ORDER BY SystemModstamp DESC) = 1\n',
    '),\n',
    'q_latest AS (\n',
    '  SELECT * FROM ', quote_tbl, '\n',
    '  QUALIFY ROW_NUMBER() OVER (\n',
    '    PARTITION BY Opportunity__c\n',
    '    ORDER BY COALESCE(SystemModstamp, LastModifiedDate, CreatedDate) DESC, Id DESC\n',
    '  ) = 1\n',
    '),\n',
    'c_latest AS (\n',
    '  SELECT * FROM ', consult_tbl, '\n',
    '  QUALIFY ROW_NUMBER() OVER (\n',
    '    PARTITION BY Opportunity__c\n',
    '    ORDER BY COALESCE(SystemModstamp, LastModifiedDate, CreatedDate) DESC, Id DESC\n',
    '  ) = 1\n',
    ')\n',
    'SELECT\n',
    '  TRIM(COALESCE(L.ConvertedOpportunityId, O.Id)) AS join_key_18,\n',
    '  CURRENT_TIMESTAMP() AS loaded_at_utc',
      CASE WHEN lead_cols    IS NULL OR lead_cols    = '' THEN '' ELSE CONCAT(',\n  ', lead_cols   ) END,
      CASE WHEN opp_cols     IS NULL OR opp_cols     = '' THEN '' ELSE CONCAT(',\n  ', opp_cols    ) END,
      CASE WHEN quote_cols   IS NULL OR quote_cols   = '' THEN '' ELSE CONCAT(',\n  ', quote_cols  ) END,
      CASE WHEN consult_cols IS NULL OR consult_cols = '' THEN '' ELSE CONCAT(',\n  ', consult_cols) END,
    '\nFROM l_dedup AS L\n',
    'FULL OUTER JOIN o_dedup AS O\n',
    '  ON TRIM(L.ConvertedOpportunityId) = TRIM(O.Id)\n',
    'LEFT JOIN q_latest AS Q\n',
    '  ON TRIM(Q.Opportunity__c) = TRIM(COALESCE(O.Id, L.ConvertedOpportunityId))\n',
    'LEFT JOIN c_latest AS C\n',
    '  ON TRIM(C.Opportunity__c) = TRIM(COALESCE(O.Id, L.ConvertedOpportunityId))\n'
  );

  EXECUTE IMMEDIATE sql;

  EXECUTE IMMEDIATE CONCAT('ALTER TABLE ', tgt, ' SET OPTIONS (description = ?) ')
  USING desc_text;

END;
