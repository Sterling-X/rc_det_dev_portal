    m_created,
    m_scheduled_initial_consultation_date,
    ROW_NUMBER() OVER (
      PARTITION BY CAST(m_custom_id AS STRING)
      ORDER BY m_created DESC
    ) AS rn
  FROM `focused-sentry-464713-u0.clio_johnson.clio_alldata_delta`
  WHERE COALESCE(TRIM(CAST(m_custom_id AS STRING)), '') <> ''
),

chisholm_dedup AS (
  SELECT
    CAST(opp_id AS STRING) AS opp_id,
    opp_createdat,
    contact_cf_contact_booked_a_call_date,
    opp_cf_opportunity_consult_completed_date,
    opp_cf_opportunity_retainer_sent_date,
    opp_cf_opportunity_funded_date,
    contact_cf_contact_weblead_indicator,
    opp_source,
    contact_cf_contact_utm_campaign,
    contact_cf_contact_utm_content,
    contact_cf_contact_utm_medium,
    contact_cf_contact_utm_source,
    contact_cf_contact_utm_term,
    contact_cf_contact_qualified_date,
    ROW_NUMBER() OVER (
      PARTITION BY CAST(opp_id AS STRING)
      ORDER BY COALESCE(
        SAFE_CAST(opp_createdat AS TIMESTAMP),
        SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(opp_createdat AS STRING))),
        SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%z',  TRIM(CAST(opp_createdat AS STRING))),
        SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(opp_createdat AS STRING))),
        SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%z',  TRIM(CAST(opp_createdat AS STRING))),
        SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S',      TRIM(CAST(opp_createdat AS STRING))),
        SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S',    TRIM(CAST(opp_createdat AS STRING)))
      ) DESC
    ) AS rn
  FROM `focused-sentry-464713-u0.gohighlevel_chisholm.chisholm_alldata_delta`
  WHERE COALESCE(TRIM(CAST(opp_id AS STRING)), '') <> ''
),

vdl AS (
  SELECT
    'VDL-vdl1001' AS Firm_Unique_ID,
    'Vasquez de Lara' AS Firm_Name,
    CONCAT(CAST(prospectid AS STRING), '-', cc.cc_type) AS Lead_Unique_ID,
    to_iso_date_string(created_at)                 AS Lead_Create_Date,
    to_iso_date_string(cf_discovery_session_date)  AS Consultation_Date,
    FORMAT_DATE('%Y-%m-%d', cc.cc_date)            AS Consult_Completed_Date,
    to_iso_date_string(cf_retainer_sent_date)      AS Retainer_Sent_Date,
    CAST(NULL AS STRING)                           AS Retainer_Signed_Date,
    to_iso_date_string(cf_date_hired)              AS Retainer_Funded_Date,
    CAST(cf_email_newsletter_opt_in AS STRING)     AS Web_Lead_Indicator,
    CAST(cf_lead_type AS STRING)                   AS Lead_Source,
    CAST(NULL AS STRING)                           AS Fee_Agreement_Sent_Date,
    CAST(NULL AS STRING)                           AS Funded_Agreements,
    CAST(cf_marketing_source AS STRING)            AS Marketing_CHANNEL,
    CAST(NULL AS STRING)                           AS Form_Submit_URL,
    CAST(cf_utm_campaign AS STRING)                AS UTM_Campaign,
    CAST(cf_utm_content  AS STRING)                AS UTM_Content,
    CAST(cf_utm_medium   AS STRING)                AS UTM_Medium,
    CAST(NULL AS STRING)                           AS UTM_Pageview_Count,
    CAST(NULL AS STRING)                           AS UTM_Session_Count,
    CAST(cf_utm_source   AS STRING)                AS UTM_Source,
    CAST(cf_utm_term     AS STRING)                AS UTM_Term,
    CAST(NULL AS STRING)                           AS gclid,
    CAST(NULL AS BOOL)                             AS _f1,
    CAST(NULL AS BOOL)                             AS _f2,
    to_iso_date_string(cf_case_eval_date)          AS QPC,
    CAST(NULL AS STRING)                           AS UTM_ICT_Reference_NUMBER,
    CAST(NULL AS STRING)                           AS ga_client_id,
    CAST(NULL AS STRING)                           AS ga_user_id
  FROM vdl_dedup
  CROSS JOIN UNNEST([
    STRUCT('ds_completed'      AS cc_type, to_date_safe(cf_ds_completed_date)       AS cc_date),
    STRUCT('consult_completed' AS cc_type, to_date_safe(cf_consult_completed_date) AS cc_date)
  ]) AS cc
  WHERE rn = 1
    AND LOWER(COALESCE(lead_sync_status, '')) = 'active'
    AND cc.cc_date IS NOT NULL

  UNION ALL

  SELECT
    'VDL-vdl1001' AS Firm_Unique_ID,
    'Vasquez de Lara' AS Firm_Name,
    CAST(prospectid AS STRING) AS Lead_Unique_ID,
    to_iso_date_string(created_at)                 AS Lead_Create_Date,
    to_iso_date_string(cf_discovery_session_date)  AS Consultation_Date,
    CAST(NULL AS STRING)                           AS Consult_Completed_Date,
    to_iso_date_string(cf_retainer_sent_date)      AS Retainer_Sent_Date,
    CAST(NULL AS STRING)                           AS Retainer_Signed_Date,
    to_iso_date_string(cf_date_hired)              AS Retainer_Funded_Date,
    CAST(cf_email_newsletter_opt_in AS STRING)     AS Web_Lead_Indicator,
    CAST(cf_lead_type AS STRING)                   AS Lead_Source,
    CAST(NULL AS STRING)                           AS Fee_Agreement_Sent_Date,
    CAST(NULL AS STRING)                           AS Funded_Agreements,
    CAST(cf_marketing_source AS STRING)            AS Marketing_CHANNEL,
    CAST(NULL AS STRING)                           AS Form_Submit_URL,
    CAST(cf_utm_campaign AS STRING)                AS UTM_Campaign,
    CAST(cf_utm_content  AS STRING)                AS UTM_Content,
    CAST(cf_utm_medium   AS STRING)                AS UTM_Medium,
    CAST(NULL AS STRING)                           AS UTM_Pageview_Count,
    CAST(NULL AS STRING)                           AS UTM_Session_Count,
    CAST(cf_utm_source   AS STRING)                AS UTM_Source,
    CAST(cf_utm_term     AS STRING)                AS UTM_Term,
    CAST(NULL AS STRING)                           AS gclid,
    CAST(NULL AS BOOL)                             AS _f1,
    CAST(NULL AS BOOL)                             AS _f2,
    to_iso_date_string(cf_case_eval_date)          AS QPC,
    CAST(NULL AS STRING)                           AS UTM_ICT_Reference_NUMBER,
    CAST(NULL AS STRING)                           AS ga_client_id,
    CAST(NULL AS STRING)                           AS ga_user_id
  FROM vdl_dedup
  WHERE rn = 1
    AND LOWER(COALESCE(lead_sync_status, '')) = 'active'
    AND to_date_safe(cf_ds_completed_date) IS NULL
    AND to_date_safe(cf_consult_completed_date) IS NULL
),

cutrer AS (
  SELECT
    'cutrerlaw-1017' AS Firm_Unique_ID,
    'Cutrer Law'      AS Firm_Name,
    CAST(prospectid AS STRING) AS Lead_Unique_ID,
    to_iso_date_keep_local(created_at) AS Lead_Create_Date,
    CAST(NULL AS STRING) AS Consultation_Date,
    CAST(NULL AS STRING) AS Consult_Completed_Date,
    CAST(NULL AS STRING) AS Retainer_Sent_Date,
    CAST(NULL AS STRING) AS Retainer_Signed_Date,
    CAST(NULL AS STRING) AS Retainer_Funded_Date,
    CAST(NULL AS STRING) AS Web_Lead_Indicator,
    CAST(NULL AS STRING) AS Lead_Source,
    CAST(NULL AS STRING) AS Fee_Agreement_Sent_Date,
    CAST(NULL AS STRING) AS Funded_Agreements,
    CAST(NULL AS STRING) AS Marketing_Channel,
    CAST(NULL AS STRING) AS Form_Submit_URL,
    CAST(utm_campaign AS STRING) AS UTM_Campaign,
    CAST(NULL AS STRING) AS UTM_Content,
    CAST(utm_medium   AS STRING) AS UTM_Medium,
    CAST(NULL AS STRING) AS UTM_Pageview_Count,
    CAST(NULL AS STRING) AS UTM_Session_Count,
    CAST(utm_source   AS STRING) AS UTM_Source,
    CAST(utm_term     AS STRING) AS UTM_Term,
    CAST(NULL AS STRING) AS gclid,
    CAST(NULL AS BOOL) AS _f1,
    CAST(NULL AS BOOL) AS _f2,
    CAST(NULL AS STRING) AS QPC,
    CAST(NULL AS STRING) AS UTM_ICT_Reference_NUMBER,
    CAST(NULL AS STRING) AS ga_client_id,
    CAST(NULL AS STRING) AS ga_user_id
  FROM cutrer_dedup
  WHERE rn = 1
),

azfamilylaw AS (
  SELECT
    'arizonafamilylaw-1015' AS Firm_Unique_ID,
    'Arizona Family Law'    AS Firm_Name,
    CAST(prospectid AS STRING) AS Lead_Unique_ID,
    to_iso_date_phoenix(created_at) AS Lead_Create_Date,
    to_iso_date_phoenix(cf_consultation_scheduled_date) AS Consultation_Date,
    CAST(cf_consult_completed_date AS STRING) AS Consult_Completed_Date,
    CAST(cf_retainer_sent AS STRING) AS Retainer_Sent_Date,
    CAST(NULL AS STRING) AS Retainer_Signed_Date,
    CAST(NULL AS STRING) AS Retainer_Funded_Date,
    CAST(NULL AS STRING) AS Web_Lead_Indicator,
    CAST(NULL AS STRING) AS Lead_Source,
    CAST(NULL AS STRING) AS Fee_Agreement_Sent_Date,
    CAST(cf_onboard_date AS STRING) AS Funded_Agreements,
    CAST(NULL AS STRING) AS Marketing_Channel,
    CAST(NULL AS STRING) AS Form_Submit_URL,
    CAST(cf_utm_campaign AS STRING) AS UTM_Campaign,
    CAST(cf_utm_content  AS STRING) AS UTM_Content,
    CAST(cf_utm_medium   AS STRING) AS UTM_Medium,
    CAST(NULL AS STRING) AS UTM_Pageview_Count,
    CAST(NULL AS STRING) AS UTM_Session_Count,
    CAST(utm_source AS STRING) AS UTM_Source,
    CAST(cf_utm_term AS STRING) AS UTM_Term,
    CAST(NULL AS STRING) AS gclid,
    CAST(NULL AS BOOL) AS _f1,
    CAST(NULL AS BOOL) AS _f2,
    CAST(NULL AS STRING) AS QPC,
    CAST(NULL AS STRING) AS UTM_ICT_Reference_NUMBER,
    CAST(NULL AS STRING) AS ga_client_id,
    CAST(NULL AS STRING) AS ga_user_id
  FROM azfamilylaw_dedup
  WHERE rn = 1
),

smb AS (
  SELECT
    'SMB-smb1002'      AS Firm_Unique_ID,
    'Scott M Brown'    AS Firm_Name,
    opp__id            AS Lead_Unique_ID,
    FORMAT_DATE('%Y-%m-%d', DATE(opp_created_ts)) AS Lead_Create_Date,
    to_iso_date_string(consult_scheduled_date) AS Consultation_Date,
    CASE
      WHEN consult_scheduled_date IS NOT NULL
       AND opp_cf_opportunity_consult_rescheduled_tag_applied IS NULL
       AND opp_cf_opportunity_consult_cancelled_tag_applied IS NULL
       AND opp_cf_opportunity_no_show_tag_applied IS NULL
       AND LOWER(opp_contact_tags) NOT LIKE '%consult not set%'
      THEN to_iso_date_string(opp_created_ts)
      ELSE NULL
    END AS Consult_Completed_Date,
    to_iso_date_string(retainer_sent_date)   AS Retainer_Sent_Date,
    CAST(NULL AS STRING)                     AS Retainer_Signed_Date,
    to_iso_date_string(retainer_funded_date) AS Retainer_Funded_Date,
    CASE WHEN is_web_lead THEN 'Website' ELSE NULL END AS Web_Lead_Indicator,
    CAST(opp_source AS STRING) AS Lead_Source,
    CAST(NULL AS STRING) AS Fee_Agreement_Sent_Date,
    CAST(NULL AS STRING) AS Funded_Agreements,
    CAST(NULL AS STRING)       AS Marketing_Channel,
    CAST(NULL AS STRING)       AS Form_Submit_URL,
    CAST(NULL AS STRING)       AS UTM_Campaign,
    CAST(NULL AS STRING)       AS UTM_Content,
    CAST(NULL AS STRING)       AS UTM_Medium,
    CAST(NULL AS STRING)       AS UTM_Pageview_Count,
    CAST(NULL AS STRING)       AS UTM_Session_Count,
    CAST(NULL AS STRING)       AS UTM_Source,
    CAST(NULL AS STRING)       AS UTM_Term,
    CAST(NULL AS STRING)       AS gclid,
    CAST(NULL AS BOOL)         AS _f1,
    CAST(NULL AS BOOL)         AS _f2,
    to_iso_date_string(qpc_date) AS QPC,
    CAST(NULL AS STRING) AS UTM_ICT_Reference_Number,
    CAST(NULL AS STRING) AS ga_client_id,
    CAST(NULL AS STRING) AS ga_user_id
  FROM smb_src
),

summit AS (
  SELECT
    'sumitfamilylawinc-sfl1006' AS Firm_Unique_ID,
    'Summit Family Law P.C.' AS Firm_Name,
    CAST(contact_record_id AS STRING) AS Lead_Unique_ID,
    to_iso_date_string(contact_create_date) AS Lead_Create_Date,
    to_iso_date_string(deal_date_entered_consultation_scheduled_sales_pipeline) AS Consultation_Date,
    to_iso_date_string(deal_date_exited_consultation_scheduled_sales_pipeline) AS Consult_Completed_Date,
    to_iso_date_string(deal_date_entered_agreement_sent_sales_pipeline) AS Retainer_Sent_Date,
    to_iso_date_string(deal_date_exited_agreement_sent_sales_pipeline) AS Retainer_Signed_Date,
    to_iso_date_string(deal_date_entered_closed_won_sales_pipeline) AS Retainer_Funded_Date,
    CASE
      WHEN UPPER(contact_latest_traffic_source) = 'DIRECT_TRAFFIC' THEN CAST(contact_latest_traffic_source AS STRING)
      ELSE NULL
    END AS Web_Lead_Indicator,
    CAST(contact_original_lead_source_drill_down_1 AS STRING) AS Lead_Source,
    CAST(NULL AS STRING) AS Fee_Agreement_Sent_Date,
    CAST(NULL AS STRING) AS Funded_Agreements,
    CAST(contact_original_lead_source AS STRING) AS Marketing_Channel,
    CAST(contact_last_referring_site AS STRING) AS Form_Submit_URL,
    CAST(contact_utm_campaign AS STRING) AS UTM_Campaign,
    CAST(contact_utm_content AS STRING) AS UTM_Content,
    CAST(contact_utm_medium AS STRING) AS UTM_Medium,
    CAST(NULL AS STRING) AS UTM_Pageview_Count,
    CAST(NULL AS STRING) AS UTM_Session_Count,
    CAST(contact_utm_source AS STRING) AS UTM_Source,
    CAST(contact_utm_term AS STRING) AS UTM_Term,
    CAST(contact_gclid AS STRING) AS gclid,
    CAST(NULL AS BOOL) AS _f1,
    CAST(NULL AS BOOL) AS _f2,
    CASE
      WHEN LOWER(TRIM(CAST(contact_lead_status AS STRING))) = 'disqualified' THEN NULL
      ELSE to_iso_date_string(contact_create_date)
    END AS QPC,
    CAST(NULL AS STRING) AS UTM_ICT_Reference_NUMBER,
    CAST(NULL AS STRING) AS ga_client_id,
    CAST(NULL AS STRING) AS ga_user_id
  FROM summit_dedup
  WHERE rn = 1
),

rosenblum AS (
