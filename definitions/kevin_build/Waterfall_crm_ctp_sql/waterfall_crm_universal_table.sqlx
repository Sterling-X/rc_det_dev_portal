CREATE TEMP FUNCTION
  to_date_safe(x ANY TYPE) AS (
    COALESCE(
      SAFE.PARSE_DATE('%Y-%m-%d', TRIM(CAST(x AS STRING))),
      SAFE.PARSE_DATE('%B %e, %Y', TRIM(CAST(x AS STRING))),
      SAFE.PARSE_DATE('%b %e, %Y', TRIM(CAST(x AS STRING))),
      SAFE.DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(x AS STRING)))),
      SAFE.DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(x AS STRING)))),
      SAFE.DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', TRIM(CAST(x AS STRING))))
    )
  );

CREATE TEMP FUNCTION
  to_iso_date_string(x ANY TYPE) AS (
    COALESCE(
      FORMAT_DATE('%Y-%m-%d', to_date_safe(x)),
      CAST(x AS STRING)
    )
  );

CREATE TEMP FUNCTION
  to_iso_date_keep_local(x ANY TYPE) AS (
    CASE
      WHEN x IS NULL THEN NULL
      WHEN REGEXP_CONTAINS(CAST(x AS STRING), r'^\d{4}-\d{2}-\d{2}T') THEN SUBSTR(CAST(x AS STRING), 1, 10)
      ELSE FORMAT_DATE('%Y-%m-%d', to_date_safe(x))
    END
  );

CREATE TEMP FUNCTION
  to_iso_date_phoenix(x ANY TYPE) AS (
    COALESCE(
      FORMAT_DATE(
        '%Y-%m-%d',
        DATE(
          COALESCE(
            SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(x AS STRING))),
            SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(x AS STRING))),
            SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S',      TRIM(CAST(x AS STRING))),
            SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S',    TRIM(CAST(x AS STRING)))
          ),
          "America/Phoenix"
        )
      ),
      FORMAT_DATE('%Y-%m-%d', SAFE.PARSE_DATE('%Y-%m-%d', TRIM(CAST(x AS STRING)))),
      FORMAT_DATE('%Y-%m-%d', SAFE.PARSE_DATE('%B %e, %Y', TRIM(CAST(x AS STRING)))),
      FORMAT_DATE('%Y-%m-%d', SAFE.PARSE_DATE('%b %e, %Y', TRIM(CAST(x AS STRING)))),
      to_iso_date_string(x)
    )
  );

CREATE TEMP FUNCTION
  to_iso_date_new_york(x ANY TYPE) AS (
    COALESCE(
      FORMAT_DATE(
        '%Y-%m-%d',
        DATE(
          COALESCE(
            SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(x AS STRING))),
            SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(x AS STRING))),
            SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S',      TRIM(CAST(x AS STRING))),
            SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S',    TRIM(CAST(x AS STRING)))
          ),
          "America/New_York"
        )
      ),
      FORMAT_DATE('%Y-%m-%d', SAFE.PARSE_DATE('%Y-%m-%d', TRIM(CAST(x AS STRING)))),
      FORMAT_DATE('%Y-%m-%d', SAFE.PARSE_DATE('%B %e, %Y', TRIM(CAST(x AS STRING)))),
      FORMAT_DATE('%Y-%m-%d', SAFE.PARSE_DATE('%b %e, %Y', TRIM(CAST(x AS STRING)))),
      to_iso_date_string(x)
    )
  );

-- Unix epoch (seconds or millis) -> YYYY-MM-DD (NY timezone)
CREATE TEMP FUNCTION
  to_iso_date_from_unix(x ANY TYPE) AS (
    (
      SELECT
        CASE
          WHEN i IS NULL THEN NULL
          ELSE FORMAT_DATE(
            '%Y-%m-%d',
            DATE(
              IF(ABS(i) >= 1000000000000, TIMESTAMP_MILLIS(i), TIMESTAMP_SECONDS(i)),
              "America/New_York"
            )
          )
        END
      FROM (
        SELECT SAFE_CAST(REGEXP_EXTRACT(TRIM(CAST(x AS STRING)), r'^-?\d+') AS INT64) AS i
      )
    )
  );

CREATE OR REPLACE TABLE
  `focused-sentry-464713-u0.crm_universal_tables.genesis_crm_universal_table` AS
WITH
vdl_dedup AS (
  SELECT
    prospectid,
    created_at,
    cf_discovery_session_date,
    cf_ds_completed_date,
    cf_consult_completed_date,
    cf_retainer_sent_date,
    cf_date_hired,
    cf_email_newsletter_opt_in,
    cf_lead_type,
    cf_marketing_source,
    cf_utm_campaign,
    cf_utm_content,
    cf_utm_medium,
    cf_utm_source,
    cf_utm_term,
    cf_case_eval_date,
    lead_sync_status,
    updated_at,
    ROW_NUMBER() OVER (PARTITION BY prospectid ORDER BY updated_at DESC) AS rn
  FROM `focused-sentry-464713-u0.lawmatics_vdl.vdl_alldata_delta`
),

cutrer_dedup AS (
  SELECT
    prospectid,
    created_at,
    utm_campaign,
    utm_medium,
    utm_source,
    utm_term,
    updated_at,
    ROW_NUMBER() OVER (PARTITION BY prospectid ORDER BY updated_at DESC) AS rn
  FROM `focused-sentry-464713-u0.lawmatics_cutrer.cutrer_alldata_delta`
),

azfamilylaw_dedup AS (
  SELECT
    prospectid,
    created_at,
    cf_consultation_date_and_time,
    cf_consultation_scheduled_date,
    cf_consult_completed_date,
    cf_retainer_sent,
    cf_onboard_date,
    cf_utm_campaign,
    cf_utm_content,
    cf_utm_medium,
    utm_source,
    cf_utm_term,
    updated_at,
    ROW_NUMBER() OVER (PARTITION BY prospectid ORDER BY updated_at DESC) AS rn
  FROM `focused-sentry-464713-u0.lawmatics_azfamilylaw.azfamilylaw_alldata_delta`
),

tde_dedup AS (
  SELECT
    prospectid,
    created_at,
    utm_campaign,
    utm_medium,
    utm_source,
    utm_term,
    updated_at,
    cf_funded_date,
    ROW_NUMBER() OVER (PARTITION BY prospectid ORDER BY updated_at DESC) AS rn
  FROM `focused-sentry-464713-u0.lawmatics_tde.tde_alldata_delta`
),

smb_src AS (
  SELECT
    CAST(opp_id AS STRING) AS opp__id,
    opp_createdat,
    opp_updatedat,
    opp_cf_opportunity_date_the_consultation_is_scheduled    AS consult_scheduled_date,
    opp_cf_opportunity_date_new_lead_became_a_qualified_lead AS qpc_date,
    opp_cf_opportunity_retainer_sent_date                    AS retainer_sent_date,
    opp_cf_opportunity_date_new_lead_became_a_client         AS retainer_funded_date,
    opp_cf_opportunity_consult_rescheduled_tag_applied,
    opp_cf_opportunity_no_show_tag_applied,
    opp_cf_opportunity_consult_cancelled_tag_applied,
    opp_cf_opportunity_not_retained_tag_applied,
    opp_cf_opportunity_consult_completed                     AS consult_completed_flag,
    opp_cf_opportunity_consult_date                          AS consult_date,
    opp_source,
    contact_source,
    contact_tags,
    opp_contact_tags,
    COALESCE(
      SAFE_CAST(opp_createdat AS TIMESTAMP),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(opp_createdat AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(opp_createdat AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S',      TRIM(CAST(opp_createdat AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S',    TRIM(CAST(opp_createdat AS STRING)))
    ) AS opp_created_ts,
    COALESCE(
      SAFE_CAST(opp_updatedat AS TIMESTAMP),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', TRIM(CAST(opp_updatedat AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', TRIM(CAST(opp_updatedat AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S',      TRIM(CAST(opp_updatedat AS STRING))),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S',    TRIM(CAST(opp_updatedat AS STRING)))
    ) AS opp_updated_ts,
    LOWER(IFNULL(contact_source, '')) AS contact_source_lc,
    LOWER(IFNULL(contact_tags,   '')) AS contact_tags_lc,
    LOWER(IFNULL(opp_contact_tags, '')) AS opp_contact_tags_lc,
    (
      LOWER(IFNULL(contact_source, '')) LIKE '%website%'
      OR (
        LOWER(IFNULL(contact_source, '')) NOT LIKE '%website%'
        AND LOWER(IFNULL(contact_tags, '')) LIKE '%website%'
      )
    ) AS is_web_lead
  FROM `focused-sentry-464713-u0.turbine_smb.smb_alldata_delta`
  WHERE COALESCE(TRIM(CAST(opp_id AS STRING)), '') <> ''
),

haffner_dedup AS (
  SELECT
    CAST(lead_id AS STRING) AS lead_id,
    lead_lastupdatedate,
    ROW_NUMBER() OVER (
      PARTITION BY CAST(lead_id AS STRING)
      ORDER BY lead_lastupdatedate DESC
    ) AS rn
  FROM `focused-sentry-464713-u0.leaddocket_haffner.initialdata_delta`
),

kalish_dedup AS (
  SELECT
    CAST(lead_id AS STRING) AS lead_id,
    lead_lastupdatedate,
    ROW_NUMBER() OVER (
      PARTITION BY CAST(lead_id AS STRING)
      ORDER BY lead_lastupdatedate DESC
