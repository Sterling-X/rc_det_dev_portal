  FROM johnson_dedup j
  WHERE rn = 1
),

chisholm AS (
  SELECT
    'chisholmlawfirm-1012' AS Firm_Unique_ID,
    'Chisholm Law Firm'    AS Firm_Name,
    CAST(opp_id AS STRING) AS Lead_Unique_ID,
    to_iso_date_keep_local(opp_createdat) AS Lead_Create_Date,
    -- non destructive way to remove the test data for January 13, 2026 (QPC, Consultation Date, Consult Completed Date, Retainer / Agreement Sent Date and Retainer / Agreement Funded Date)
    -- Logic updated to NULL out dates on or before 2026-01-13
    CASE
        WHEN to_iso_date_from_unix(contact_cf_contact_booked_a_call_date) <= '2026-01-13' THEN NULL 
        ELSE to_iso_date_from_unix(contact_cf_contact_booked_a_call_date)
    END AS Consultation_Date,

    CASE
        WHEN to_iso_date_keep_local(opp_cf_opportunity_consult_completed_date) <= '2026-01-13' THEN NULL
        ELSE to_iso_date_keep_local(opp_cf_opportunity_consult_completed_date) 
    END AS Consult_Completed_Date,
    
    CASE
        WHEN to_iso_date_keep_local(opp_cf_opportunity_retainer_sent_date) <= '2026-01-13' THEN NULL 
        ELSE to_iso_date_keep_local(opp_cf_opportunity_retainer_sent_date) 
    END AS Retainer_Sent_Date,
    CAST(NULL AS STRING) AS Retainer_Signed_Date,
    CASE
        WHEN to_iso_date_keep_local(opp_cf_opportunity_funded_date) <= '2026-01-13' THEN NULL 
        ELSE to_iso_date_keep_local(opp_cf_opportunity_funded_date)
    END AS Retainer_Funded_Date,


        CASE
      WHEN to_iso_date_keep_local(opp_createdat) <= '2026-01-13' THEN NULL
      WHEN REGEXP_CONTAINS(CAST(contact_cf_contact_weblead_indicator AS STRING), r'WebLead Indicator') THEN '1'
      ELSE NULL
    END AS Web_Lead_Indicator,
    CAST(opp_source AS STRING) AS Lead_Source,
    CAST(NULL AS STRING) AS Fee_Agreement_Sent_Date,
    CAST(NULL AS STRING) AS Funded_Agreements,
    CAST(NULL AS STRING) AS Marketing_Channel,
    CAST(NULL AS STRING) AS Form_Submit_URL,
    CAST(contact_cf_contact_utm_campaign AS STRING) AS UTM_Campaign,
    CAST(contact_cf_contact_utm_content AS STRING) AS UTM_Content,
    CAST(contact_cf_contact_utm_medium AS STRING) AS UTM_Medium,
    CAST(NULL AS STRING) AS UTM_Pageview_Count,
    CAST(NULL AS STRING) AS UTM_Session_Count,
    CAST(contact_cf_contact_utm_source AS STRING) AS UTM_Source,
    CAST(contact_cf_contact_utm_term AS STRING) AS UTM_Term,
    CAST(NULL AS STRING) AS gclid,
    CAST(NULL AS BOOL) AS _f1,
    CAST(NULL AS BOOL) AS _f2,
        CASE
        WHEN to_iso_date_keep_local(contact_cf_contact_qualified_date) <= '2026-01-13' THEN NULL 
        ELSE to_iso_date_keep_local(contact_cf_contact_qualified_date)
    END AS QPC,
    CAST(NULL AS STRING) AS UTM_ICT_Reference_NUMBER,
    CAST(NULL AS STRING) AS ga_client_id,
    CAST(NULL AS STRING) AS ga_user_id
  FROM chisholm_dedup
  WHERE rn = 1
),

tde AS (
  SELECT
    'tdefamilylaw-1024' AS Firm_Unique_ID,
    'Tessie D. Edwards & Associates Family Law' AS Firm_Name,
    CAST(prospectid AS STRING) AS Lead_Unique_ID,
    to_iso_date_keep_local(created_at) AS Lead_Create_Date,
    CAST(NULL AS STRING) AS Consultation_Date,
    CAST(NULL AS STRING) AS Consult_Completed_Date,
    CAST(NULL AS STRING) AS Retainer_Sent_Date,
    CAST(NULL AS STRING) AS Retainer_Signed_Date,
    CAST(cf_funded_date AS STRING) AS Retainer_Funded_Date,
    CAST(NULL AS STRING) AS Web_Lead_Indicator,
    CAST(NULL AS STRING) AS Lead_Source,
    CAST(NULL AS STRING) AS Fee_Agreement_Sent_Date,
    CAST(NULL AS STRING) AS Funded_Agreements,
    CAST(NULL AS STRING) AS Marketing_Channel,
    CAST(NULL AS STRING) AS Form_Submit_URL,
    CAST(utm_campaign AS STRING) AS UTM_Campaign,
    CAST(NULL AS STRING) AS UTM_Content,
    CAST(utm_medium AS STRING) AS UTM_Medium,
    CAST(NULL AS STRING) AS UTM_Pageview_Count,
    CAST(NULL AS STRING) AS UTM_Session_Count,
    CAST(utm_source AS STRING) AS UTM_Source,
    CAST(utm_term AS STRING) AS UTM_Term,
    CAST(NULL AS STRING) AS gclid,
    CAST(NULL AS BOOL) AS _f1,
    CAST(NULL AS BOOL) AS _f2,
    CAST(NULL AS STRING) AS QPC,
    CAST(NULL AS STRING) AS UTM_ICT_Reference_NUMBER,
    CAST(NULL AS STRING) AS ga_client_id,
    CAST(NULL AS STRING) AS ga_user_id
  FROM tde_dedup
  WHERE rn = 1
),

slo_base AS (
  SELECT
    s.*,
    DATE(COALESCE(
      SAFE_CAST(lead_CreatedDate AS TIMESTAMP),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', SAFE_CAST(lead_CreatedDate AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', SAFE_CAST(lead_CreatedDate AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S UTC',  SAFE_CAST(lead_CreatedDate AS STRING))
    ), 'America/New_York') AS lead_created_central_d,
    DATE(COALESCE(
      SAFE_CAST(opportunity_CreatedDate AS TIMESTAMP),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', SAFE_CAST(opportunity_CreatedDate AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', SAFE_CAST(opportunity_CreatedDate AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S UTC',  SAFE_CAST(opportunity_CreatedDate AS STRING))
    ), 'America/New_York') AS opportunity_created_central_d,
    DATE(COALESCE(
      SAFE_CAST(opportunity_Consult_Date_Time__c AS TIMESTAMP),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', SAFE_CAST(opportunity_Consult_Date_Time__c AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', SAFE_CAST(opportunity_Consult_Date_Time__c AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S UTC',  SAFE_CAST(opportunity_Consult_Date_Time__c AS STRING))
    ), 'America/New_York') AS consult_start_central_d,
    DATE(COALESCE(
      SAFE_CAST(consult_CreatedDate AS TIMESTAMP),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', SAFE_CAST(consult_CreatedDate AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S%Ez', SAFE_CAST(consult_CreatedDate AS STRING)),
      SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S UTC',  SAFE_CAST(consult_CreatedDate AS STRING))
    ), 'America/New_York') AS consult_created_central_d,
    COALESCE(
      SAFE_CAST(lead_Referred_Out_Date__c AS DATE),
      SAFE.PARSE_DATE('%Y-%m-%d', SAFE_CAST(lead_Referred_Out_Date__c AS STRING)),
      SAFE.PARSE_DATE('%m/%d/%Y', SAFE_CAST(lead_Referred_Out_Date__c AS STRING)),
      SAFE.PARSE_DATE('%Y-%m-%d.', SAFE_CAST(lead_Referred_Out_Date__c AS STRING))
    ) AS lead_referred_out_d,
    COALESCE(
      SAFE_CAST(opportunity_Reinstituted_Funded_Date__c AS DATE),
      SAFE.PARSE_DATE('%Y-%m-%d', SAFE_CAST(opportunity_Reinstituted_Funded_Date__c AS STRING)),
      SAFE.PARSE_DATE('%m/%d/%Y', SAFE_CAST(opportunity_Reinstituted_Funded_Date__c AS STRING)),
      SAFE.PARSE_DATE('%Y-%m-%d.', SAFE_CAST(opportunity_Reinstituted_Funded_Date__c AS STRING))
    ) AS funded_reinstituted_d,
    NOT REGEXP_CONTAINS(COALESCE(SAFE_CAST(lead_LeadSource AS STRING), ''), r'(?i)nps') AS leadsource_not_nps,
    (SAFE_CAST(lead_IsConverted AS BOOL) IS FALSE OR LOWER(TRIM(SAFE_CAST(lead_IsConverted AS STRING))) IN ('false','f','0','no','n')) AS is_converted_falseish,
    (SAFE_CAST(lead_Potential_Lead__c AS BOOL) IS FALSE OR LOWER(TRIM(SAFE_CAST(lead_Potential_Lead__c AS STRING))) IN ('false','f','0','no','n')) AS is_potential_falseish,
    (SAFE_CAST(lead_Web_Lead__c AS BOOL) IS TRUE  OR LOWER(TRIM(SAFE_CAST(lead_Web_Lead__c AS STRING)))  IN ('true','t','1','yes','y')) AS is_web_trueish,
    NOT REGEXP_CONTAINS(COALESCE(SAFE_CAST(quote_Opportunity_Account_Name__c AS STRING), ''), r'(?i)participant') AS oppacct_not_participant,
    NOT REGEXP_CONTAINS(COALESCE(SAFE_CAST(opportunity_Name AS STRING), ''), r'(?i)test') AS oppname_not_test,
    SAFE_CAST(quote_Opportunity__c AS STRING) = SAFE_CAST(opportunity_Id AS STRING) AS has_quote_link
  FROM `focused-sentry-464713-u0.salesforce_slo.slo_alldata_delta` s
),

slo_dedup AS (
  SELECT
    *,
    ROW_NUMBER() OVER (
      PARTITION BY CAST(lead_Id AS STRING)
      ORDER BY lead_created_central_d DESC, opportunity_created_central_d DESC
    ) AS rn
  FROM slo_base
  WHERE lead_created_central_d IS NOT NULL
    AND leadsource_not_nps
    AND is_converted_falseish
    AND is_potential_falseish
    AND COALESCE(TRIM(CAST(lead_Id AS STRING)), '') <> ''
),

slo AS (
  SELECT
    'SterlingLawOffice-1010' AS Firm_Unique_ID,
    'Sterling Lawyers' AS Firm_Name,
    CAST(lead_Id AS STRING) AS Lead_Unique_ID,
    to_iso_date_string(lead_created_central_d) AS Lead_Create_Date,
    CASE
      WHEN consult_start_central_d IS NOT NULL
           AND oppacct_not_participant
      THEN to_iso_date_string(consult_start_central_d)
      ELSE NULL
    END AS Consultation_Date,
    CASE
      WHEN consult_created_central_d IS NOT NULL
           AND LOWER(TRIM(SAFE_CAST(consult_Consult_Status__c AS STRING))) IN (
             'signed in person - paid',
             'signed in person - unpaid',
             'consult completed',
             'complete'
           )
      THEN to_iso_date_string(consult_created_central_d)
      ELSE NULL
    END AS Consult_Completed_Date,
    CAST(NULL AS STRING) AS Retainer_Sent_Date,
    CAST(NULL AS STRING) AS Retainer_Signed_Date,
    CASE
      WHEN funded_reinstituted_d IS NOT NULL
      THEN to_iso_date_string(funded_reinstituted_d)
      ELSE NULL
    END AS Retainer_Funded_Date,
    CASE
      WHEN is_web_trueish THEN 'Website'
      ELSE NULL
    END AS Web_Lead_Indicator,
    CAST(lead_LeadSource AS STRING) AS Lead_Source,
    CAST(NULL AS STRING) AS Fee_Agreement_Sent_Date,
    CAST(NULL AS STRING) AS Funded_Agreements,
    CAST(NULL AS STRING) AS Marketing_Channel,
    CAST(NULL AS STRING) AS Form_Submit_URL,
    CAST(NULL AS STRING) AS UTM_Campaign,
    CAST(NULL AS STRING) AS UTM_Content,
    CAST(NULL AS STRING) AS UTM_Medium,
    CAST(NULL AS STRING) AS UTM_Pageview_Count,
    CAST(NULL AS STRING) AS UTM_Session_Count,
    CAST(NULL AS STRING) AS UTM_Source,
    CAST(NULL AS STRING) AS UTM_Term,
    CAST(NULL AS STRING) AS gclid,
    CAST(NULL AS BOOL) AS _f1,
    CAST(NULL AS BOOL) AS _f2,
    CAST(NULL AS STRING) AS QPC,
    CAST(NULL AS STRING) AS UTM_ICT_Reference_NUMBER,
    CAST(NULL AS STRING) AS ga_client_id,
    CAST(NULL AS STRING) AS ga_user_id
  FROM slo_dedup
  WHERE rn = 1
)

SELECT * FROM vdl
UNION ALL SELECT * FROM cutrer
UNION ALL SELECT * FROM azfamilylaw
UNION ALL SELECT * FROM smb
UNION ALL SELECT * FROM summit
UNION ALL SELECT * FROM rosenblum
UNION ALL SELECT * FROM meyerpink
UNION ALL SELECT * FROM aurit
UNION ALL SELECT * FROM haffner
UNION ALL SELECT * FROM kalish
UNION ALL SELECT * FROM ireland
UNION ALL SELECT * FROM brucelaw
UNION ALL SELECT * FROM johnson
UNION ALL SELECT * FROM chisholm
