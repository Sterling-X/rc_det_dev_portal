  NULLIF(TRIM(SPLIT(TRIM(name), ' ')[SAFE_OFFSET(0)]), ''),
  NULLIF(TRIM(ARRAY_TO_STRING(ARRAY(SELECT part FROM UNNEST(SPLIT(TRIM(name), ' ')) AS part WITH OFFSET pos WHERE pos > 0), ' ')), ''),
  REGEXP_REPLACE(phone_number, r'[^0-9]', ''),
  LOWER(TRIM(email)), 
  gclid, 
  CURRENT_TIMESTAMP()
FROM `focused-sentry-464713-u0.universal_quick_crm_lancaster.leads`
WHERE created_date IS NOT NULL;