-- ============================================================
-- TABLE 3 of 3: CRM INTAKE
-- Partition : event_date (DATE)
-- Cluster   : account_name, source_platform
-- ============================================================

CREATE TABLE IF NOT EXISTS
  `rc-datamart-report-082025.leads_data_reconciliation.crm_intake`
(
  event_date                DATE     NOT NULL,
  account_name              STRING   NOT NULL,
  source_platform           STRING,
  source_dataset            STRING,
  crm_record_identifier     STRING,
  crm_first_name            STRING,
  crm_last_name             STRING,
  normalized_phone_number   STRING,
  validated_email_address   STRING,
  matched_click_id          STRING,
  ingested_at               TIMESTAMP
)
PARTITION BY event_date
CLUSTER BY account_name, source_platform
OPTIONS (description = 'Confirmed CRM intake records. One row per lead/matter per account.');

-- ============================================================
-- BACKFILL — CRM INTAKE
-- ============================================================

-- ── Cutrer Law (Lawmatics) ───────────────────────────────────
INSERT INTO `rc-datamart-report-082025.leads_data_reconciliation.crm_intake`
SELECT 
  DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%S%Ez', created_at)),
  'Cutrer Law', 
  'Lawmatics', 
  'lawmatics_cutrer.cutrer_alldata_delta',
  prospectid, 
  NULLIF(TRIM(first_name), ''), 
  NULLIF(TRIM(last_name), ''),
  REGEXP_REPLACE(COALESCE(phone_number, phone, ''), r'[^0-9]', ''),
  LOWER(TRIM(COALESCE(NULLIF(email, ''), NULLIF(email_address, '')))),
  gclid, 
  CURRENT_TIMESTAMP()
FROM `focused-sentry-464713-u0.lawmatics_cutrer.cutrer_alldata_delta`
WHERE created_at IS NOT NULL AND SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%S%Ez', created_at) IS NOT NULL;

-- ── Scott M Brown (Turbine) ──────────────────────────────
INSERT INTO `rc-datamart-report-082025.leads_data_reconciliation.crm_intake`
SELECT 
  DATE(contact_dateadded),
  'Scott M Brown', 
  'Turbine', 
  'turbine_smb.smb_alldata_delta',
  contact_id, 
  NULLIF(TRIM(contact_firstname), ''), 
  NULLIF(TRIM(contact_lastname), ''),
  REGEXP_REPLACE(CAST(contact_phone AS STRING), r'[^0-9]', ''),
  LOWER(TRIM(contact_email)), 
  contact_cf_contact_waterfall_gclid, 
  CURRENT_TIMESTAMP()
FROM `focused-sentry-464713-u0.turbine_smb.smb_alldata_delta`
WHERE contact_dateadded IS NOT NULL; 

