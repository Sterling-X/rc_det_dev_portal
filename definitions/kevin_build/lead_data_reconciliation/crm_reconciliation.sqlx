-- ── Johnson Law Group (Clio) ─────────────────────────────────
INSERT INTO `rc-datamart-report-082025.leads_data_reconciliation.crm_intake`
SELECT 
  DATE(matter_created_at),
  'Johnson Law Group', 
  'Clio', 
  'clio_johnson.alldata_delta',
  matter_id, 
  NULLIF(TRIM(SPLIT(TRIM(matter_client_full_name), ' ')[SAFE_OFFSET(0)]), ''),
  NULLIF(TRIM(ARRAY_TO_STRING(ARRAY(SELECT part FROM UNNEST(SPLIT(TRIM(matter_client_full_name), ' ')) AS part WITH OFFSET pos WHERE pos > 0), ' ')), ''),
  REGEXP_REPLACE(COALESCE(matter_client_phone_number, matter_primary_contact_phone_number, ''), r'[^0-9]', ''),
  LOWER(TRIM(COALESCE(NULLIF(matter_client_primary_email, ''), NULLIF(matter_primary_contact_primary_email, '')))),
  NULL, 
  CURRENT_TIMESTAMP()
FROM `focused-sentry-464713-u0.clio_johnson.alldata_delta`
WHERE matter_created_at IS NOT NULL;

-- ── Lancaster Law Group (QuickCRM) ──────────────────────────
