-- ── Haffner Law (CallTrackingMetrics) ────────────────────────
INSERT INTO `rc-datamart-report-082025.leads_data_reconciliation.inbound_calls`
SELECT
  DATE(SAFE_CAST(called_at AS TIMESTAMP)),
  'Haffner Law', 'CallTrackingMetrics', 'calltracking_haffner.ctp_initialdata_delta',
  sid, SAFE_CAST(called_at AS TIMESTAMP),
  tracking_number, caller_number,
  CASE 
    WHEN LOWER(call_status) = 'no answer' THEN 'Missed' 
    WHEN LOWER(call_status) = 'answered' THEN 'Answered' 
    ELSE call_status 
  END,
  NULL, CURRENT_TIMESTAMP()
FROM `focused-sentry-464713-u0.calltracking_haffner.ctp_initialdata_delta`
WHERE called_at IS NOT NULL AND SAFE_CAST(called_at AS TIMESTAMP) IS NOT NULL;

