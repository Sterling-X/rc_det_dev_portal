-- ============================================================
-- TABLE 1 of 3: INBOUND CALLS
-- Partition : event_date (DATE)
-- Cluster   : account_name
-- ============================================================

CREATE TABLE IF NOT EXISTS
  `rc-datamart-report-082025.leads_data_reconciliation.inbound_calls`
(
  event_date                  DATE     NOT NULL,
  account_name                STRING   NOT NULL,
  source_platform             STRING,
  source_dataset              STRING,
  unique_call_identifier      STRING,
  event_start_timestamp       TIMESTAMP,
  destination_tracking_number STRING,
  originating_caller_number   STRING,
  disposition                 STRING,
  gclid                       STRING,
  ingested_at                 TIMESTAMP
)
PARTITION BY event_date
CLUSTER BY account_name
OPTIONS (description = 'Daily inbound call activity. One row per call per account.');

-- ============================================================
-- BACKFILL — INBOUND CALLS
-- ============================================================

-- ── Cutrer Law (CallRail) ───────────────────────────────────────────────
INSERT INTO `rc-datamart-report-082025.leads_data_reconciliation.inbound_calls`
SELECT
  DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%S%Ez', start_time)),
  'Cutrer Law', 'CallRail', 'callrail_cutrer.callrail_alldata_delta',
  id, SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%S%Ez', start_time),
  tracking_phone_number, customer_phone_number,
  CASE 
    WHEN voicemail = TRUE THEN 'Voicemail' 
    WHEN answered = TRUE THEN 'Answered' 
    ELSE 'Missed' 
  END,
  gclid, CURRENT_TIMESTAMP()
FROM `focused-sentry-464713-u0.callrail_cutrer.callrail_alldata_delta`
WHERE start_time IS NOT NULL AND SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%S%Ez', start_time) IS NOT NULL;

