-- ============================================================
-- TABLE 2 of 3: WEB FORM SUBMISSIONS
-- Partition : event_date (DATE)
-- Cluster   : account_name
-- ============================================================

CREATE TABLE IF NOT EXISTS
  `rc-datamart-report-082025.leads_data_reconciliation.webform_submissions`
(
  event_date                DATE     NOT NULL,
  account_name              STRING   NOT NULL,
  source_platform           STRING,
  source_dataset            STRING,
  prospect_given_name       STRING,
  prospect_surname          STRING,
  contact_email_address     STRING,
  originating_page_url      STRING,
  gclid                     STRING,
  ingested_at               TIMESTAMP
)
PARTITION BY event_date
CLUSTER BY account_name
OPTIONS (description = 'Normalized web form submissions. One row per submission per account.');


-- ============================================================
-- BACKFILL — WEB FORM SUBMISSIONS
-- ============================================================

-- ── Cutrer Law ───────────────────────────────────────────────
INSERT INTO `rc-datamart-report-082025.leads_data_reconciliation.webform_submissions`
SELECT 
  DATE(received_at), 
  'Cutrer Law', 
  'WordPress', 
  'webhook_wordpress_cutrer.fct_webhook_wordpress_cutrer_contactform_expanded',
  NULLIF(TRIM(form_data_text_506), ''), 
  NULLIF(TRIM(form_data_text_508), ''),
  LOWER(TRIM(COALESCE(NULLIF(form_data_email_17, ''), NULLIF(form_data_email_49, '')))),
  page_url, 
  NULL, 
  CURRENT_TIMESTAMP()
FROM `rc-datamart-forms-webhook.webhook_wordpress_cutrer.fct_webhook_wordpress_cutrer_contactform_expanded`
WHERE received_at IS NOT NULL;


